---
/**
 * Layout for MDX case-study / editorial pages — simpler chrome than
 * the full splash-page layout. Drops prism-specific scripts (no hero
 * video, no reveal) and ships only the shared nav + grain overlay.
 */
import '@styles/fonts.css';       /* self-hosted woff2 — must precede core.css */
import '@styles/core.css';
import '@styles/build-notes.css';
import '@styles/blend.css';        /* section blending — unified ground, feathered seams, drifting field */
import '@styles/elevate.css';      /* premium interaction layer — selection, scrollbar, focus, footer */
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import LeadEvents from '@components/LeadEvents.astro';
import LogoSymbol from '@components/LogoSymbol.astro';
import WhiteLightOverlay from '@components/WhiteLightOverlay.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    canonical?: string;
  };
}

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title || frontmatter.title || 'KR8TIV build notes';
const description =
  Astro.props.description ||
  frontmatter.description ||
  'Build notes from KR8TIV: WebGL, motion, Astro architecture, and the craft behind the Prism site.';
const canonicalPath = Astro.props.canonical || frontmatter.canonical || Astro.url.pathname;
const canonical = new URL(canonicalPath, Astro.site ?? 'https://kr8tiv.io').toString();
const siteUrl = 'https://kr8tiv.io';
const ogImage = siteUrl + '/kr8tiv-assets/og-card-v2.png';
// Structured data for editorial pages (added Nov 2026): the page as a
// TechArticle by Matt Haynes (#matt, /about/), plus breadcrumbs. Same
// @ids as the main Seo.astro graph so engines merge the entities.
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': canonical + '#article',
    headline: title.replace(/ \| KR8TIV$/, ''),
    description,
    url: canonical,
    mainEntityOfPage: canonical,
    image: ogImage,
    inLanguage: 'en-CA',
    author: { '@type': 'Person', '@id': siteUrl + '/#matt', name: 'Matt Haynes', url: siteUrl + '/about/' },
    publisher: { '@type': 'Organization', '@id': siteUrl + '/#organization', name: 'KR8TIV', url: siteUrl, logo: { '@type': 'ImageObject', url: siteUrl + '/kr8tiv-assets/kr8tiv-logo-schema.png' } }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: title.replace(/ \| KR8TIV$/, ''), item: canonical }
    ]
  }
];
---
<!DOCTYPE html>
<html lang="en-CA" data-theme="dark" data-variant="editorial">
<head>
  <!-- Theme bootstrap: runs before first paint so there is no flash.
       Dark is ALWAYS the first-visit default, whatever the OS setting.
       Only an explicit toggle click (stored under kr8tiv-theme-choice)
       can switch to light. The old key "kr8tiv-theme" was auto-written
       from prefers-color-scheme, so it is ignored and cleared. -->
  <script is:inline>(function(){var d=document.documentElement,t='dark';try{localStorage.removeItem('kr8tiv-theme');var s=localStorage.getItem('kr8tiv-theme-choice');if(s==='light'||s==='dark')t=s;}catch(e){}d.setAttribute('data-theme',t);})();</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="SU_g4oEwXofL7_hRZXpstCSkVWEIK3I-1N6nyCp1c5w" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="describedby" href="https://kr8tiv.io/llms.txt" />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <meta name="author" content="Matt Haynes" />
  <meta property="og:site_name" content="KR8TIV" />
  <meta property="og:locale" content="en_CA" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="KR8TIV, creative studio in Edmonton, Alberta" />
  <meta name="twitter:image" content={ogImage} />
  {ld.map((node) => <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/kr8tiv-assets/cropped-Design-24-32x32.png" />
  <!-- Self-hosted fonts (src/styles/fonts.css) — see BaseLayout for why
       the third-party stylesheet was dropped. Editorial pages lead with
       body copy, so the serif + mono latin subsets are preloaded. -->
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="/fonts/instrument-serif-normal-400-latin.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="/fonts/jetbrains-mono-normal-100800-latin.woff2" />

  <!-- Google Analytics 4 (gtag.js) — same property as BaseLayout. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MC0STCCGFY"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-MC0STCCGFY');
  </script>
</head>
<body>
  <LogoSymbol />
  <div class="noise"></div>
  <div class="cur" id="cur"><span class="l" id="cur-l"></span></div>
  <div class="prog" id="prog"></div>
  <Nav />
  <main class="case-study">
    <article>
      <slot />
    </article>
  </main>
  <Footer />
  <LeadEvents />
  <WhiteLightOverlay />
  <script>
    import { initMotionToggle } from '@lib/motionToggle';
    import { isPhoneClassTouch } from '@lib/devicePolicy';
    const phoneClassTouch = isPhoneClassTouch();
    if (!phoneClassTouch) {
      import('@lib/scrollCore').then((m) => m.initScrollCore());
    }
    initMotionToggle();
    if (window.matchMedia('(pointer: fine)').matches) {
      import('@lib/cursor').then((m) => m.initCursor());
    }
    const onIdle = (fn: () => void): void => {
      const w = window as Window & {
        requestIdleCallback?: (cb: IdleRequestCallback, opts?: IdleRequestOptions) => number;
      };
      if (typeof w.requestIdleCallback === 'function') w.requestIdleCallback(() => fn(), { timeout: 1200 });
      else window.setTimeout(fn, 280);
    };
    onIdle(() => {
      if (phoneClassTouch) return;
      void Promise.all([
        import('@lib/whiteLight'),
        import('@lib/asciiDither')
      ]).then(([white, ascii]) => {
        white.initWhiteLight();
        ascii.initAsciiDither();
      });
    });
  </script>
</body>
</html>
