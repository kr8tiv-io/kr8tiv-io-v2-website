---
/**
 * Base layout shared across every variant page.
 * Handles <head>, fonts, grain/noise overlays, nav, scroll-progress bar,
 * custom cursor, and mounts the shared client-side lib wiring (Lenis,
 * GSAP ticker sync, motion toggle, magnetic CTAs, white-light easter
 * egg). Variant-specific logic is handled inside the variant's <slot>.
 *
 * SEO surface lives inside <Seo />. Pass page-level props through.
 */
import '@styles/fonts.css';       /* self-hosted woff2 — must precede core.css */
import '@styles/core.css';
import '@styles/light-theme.css';  /* cohesive light palette when data-theme="light" */
import '@styles/responsive.css';   /* comprehensive mobile + tablet overrides */
import '@styles/blend.css';        /* section blending — unified ground, feathered seams, drifting field */
import '@styles/elevate.css';      /* premium interaction layer — hovers, card physics, brand chrome */
import Nav from '@components/Nav.astro';
import VariantBar from '@components/VariantBar.astro';
import WhiteLightOverlay from '@components/WhiteLightOverlay.astro';
import LogoSymbol from '@components/LogoSymbol.astro';
import Seo from '@components/Seo.astro';
import OracleOverlay from '@components/OracleOverlay.astro';
import KintsugiOverlay from '@components/KintsugiOverlay.astro';
import Footer from '@components/Footer.astro';
import type { FaqItem, HowToStep, Crumb } from '@components/Seo.astro';

export interface Props {
  title?: string;
  description?: string;
  variant?: string;
  activeVariant?: string;
  canonical?: string;
  ogImage?: string;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'Article';
  breadcrumbs?: Crumb[];
  faqs?: FaqItem[];
  howTo?: { name: string; description: string; totalTime?: string; steps: HowToStep[] };
  keywords?: string[];
  currentNav?: 'home' | 'process' | 'start' | 'work' | 'terms' | 'other';
  /** Above-the-fold image to preload for LCP (e.g. a hero poster). */
  lcpImage?: string;
}

const {
  /* Title trimmed from 84ch (over the 60ch SEO recommendation) to
     58ch — passes SeaOcean's title-length check, keeps the brand
     mark + the cyber-renaissance positioning. */
  title = 'KR8TIV · Cyber-renaissance design atelier (侍)',
  /* Description trimmed from 232ch (over 160ch) to 156ch — fits
     SERP snippet width without truncation. */
  description = 'Cyber-renaissance design atelier in Alberta, Canada. Brand, web, motion, video, and AI business solutions for founders who want to be memorable, not generic.',
  variant = 'prism',
  activeVariant = 'v8-prism',
  canonical,
  ogImage,
  pageType,
  breadcrumbs,
  faqs,
  howTo,
  keywords,
  currentNav = 'home',
  lcpImage
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark" data-variant={variant}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <Seo
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    type={pageType}
    breadcrumbs={breadcrumbs}
    faqs={faqs}
    howTo={howTo}
    keywords={keywords}
  />
  <link rel="icon" href="/kr8tiv-assets/cropped-Design-24-32x32.png" />
  <link rel="apple-touch-icon" href="/kr8tiv-assets/cropped-Design-24-32x32.png" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Speculation Rules: prerender neighboring variant pages so the
       variant-bar feels instant on Chrome/Edge. -->
  <script type="speculationrules" is:inline set:html={JSON.stringify({
    prerender: [{ source: 'document', where: { href_matches: '/kr8tiv-v*' }, eagerness: 'moderate' }]
  })}></script>

  <!-- Fonts — self-hosted woff2 (see src/styles/fonts.css). Variable
       axes are preserved (JetBrains Mono 100–800, Inter Tight 100–900)
       so font-variation-settings can still be tweened at runtime by
       scroll velocity / hover state.

       Previously these came from fonts.googleapis.com behind a
       media="print" swap: that dodged render-blocking but cost a DNS
       + TLS + CSS round trip to a third origin before the browser
       even learned which woff2 to request — on a throttled phone that
       is most of a second of fallback-font text. Same bytes, own
       origin, discovered on the first connection.

       The two faces the first screen actually paints (hero serif +
       mono chrome, latin subset) are preloaded; the rest arrive with
       the stylesheet. `crossorigin` is required on font preloads even
       same-origin — without it the preload is fetched in a different
       CORS mode than the CSS request and downloads twice. -->
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="/fonts/instrument-serif-normal-400-latin.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="/fonts/jetbrains-mono-normal-100800-latin.woff2" />
  <link rel="dns-prefetch" href="https://calendly.com" />

  <!-- LCP hint: on pages whose first paint is a poster frame behind a
       video (the homepage hero), preloading it means the largest
       element decodes while the JS chunks are still parsing instead
       of after the lazy-video observer fires. Opt-in per page — a
       blanket preload would be a wasted request on /work/ or /terms/. -->
  {lcpImage && <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />}

  <!-- Google Analytics 4 (gtag.js) — property G-MC0STCCGFY, account
       KR8TiV Design Agency. async means the script never blocks paint. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MC0STCCGFY"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-MC0STCCGFY');
  </script>
</head>
<body>
  <!-- Inline SVG defs: logo glyph + liquid-glass filter, reachable by
       url(#liquidGlass) / <use href="#kr8tiv-glyph"> from any component. -->
  <LogoSymbol />

  {/* The drifting atmosphere every section dissolves through. Fixed,
      behind all content, no text or imagery on it — see blend.css. */}
  <div class="flow-field" aria-hidden="true"></div>

  <div class="grain"></div>
  <div class="noise"></div>
  <canvas id="trail-canvas"></canvas>
  <div class="cur" id="cur"><span class="l" id="cur-l"></span></div>
  <div class="prog" id="prog"></div>

  <Nav current={currentNav} />

  <main>
    <slot />
  </main>

  <Footer />

  <VariantBar active={activeVariant} />
  <WhiteLightOverlay />

  <!-- HYBRID · sitewide menu layers -->
  <OracleOverlay />
  <KintsugiOverlay />

  <!-- Client-side wiring. Astro bundles this through Vite — tree-shakes
       unused exports. Type-checked at build time. -->
  <script>
    import { initMotionToggle } from '@lib/motionToggle';
    import { initMusic, initAudioReactiveNote } from '@lib/audioNote';
    import { initSceneAnnouncer } from '@lib/a11yAnnounce';
    import { initLazyVideos } from '@lib/lazyVideo';
    import { initOracle } from '@lib/oracle';
    import { initKintsugi } from '@lib/kintsugi';
    import { initMultiStateNav } from '@lib/multiStateNav';
    import { isPhoneClassTouch } from '@lib/devicePolicy';

    // Resilience wrapper: one init failing must not silently cascade
    // into later inits. Previously a stale Vite dep cache for gsap/lenis
    // would throw in initScrollCore and kill every later init in the
    // chain (including the Oracle + Kintsugi menu bindings) — leaving
    // the user with no navigable UI. Each init is now isolated.
    const safe = (name: string, fn: () => unknown): void => {
      try { fn(); } catch (err) { console.error(`[KR8] ${name} failed:`, err); }
    };

    // Non-critical visual layers are deferred to idle so first paint /
    // interaction comes from the core nav + scroll systems first.
    const onIdle = (fn: () => void): void => {
      const w = window as Window & {
        requestIdleCallback?: (cb: IdleRequestCallback, opts?: IdleRequestOptions) => number;
      };
      if (typeof w.requestIdleCallback === 'function') {
        w.requestIdleCallback(() => fn(), { timeout: 1200 });
      } else {
        window.setTimeout(fn, 280);
      }
    };

    const phoneClassTouch = isPhoneClassTouch();
    if (!phoneClassTouch) {
      import('@lib/scrollCore')
        .then((m) => safe('scrollCore', () => m.initScrollCore()))
        .catch((err) => console.error('[KR8] scrollCore import failed:', err));
    }
    if (window.matchMedia('(pointer: fine)').matches) {
      import('@lib/cursor')
        .then((m) => safe('cursor', () => m.initCursor()))
        .catch((err) => console.error('[KR8] cursor import failed:', err));
    }
    safe('motionToggle',     () => initMotionToggle());
    safe('music',            () => initMusic());
    safe('audioReactiveNote',() => initAudioReactiveNote());
    safe('sceneAnnouncer',   () => initSceneAnnouncer());
    safe('lazyVideos',       () => initLazyVideos());
    // Section blending drives one custom property per frame — it belongs
    // with the core scroll wiring, not the deferred visual layer, or the
    // page would render its seams flat for the first second.
    import('@lib/sectionFlow')
      .then((m) => safe('sectionFlow', () => m.initSectionFlow()))
      .catch((err) => console.error('[KR8] sectionFlow import failed:', err));
    onIdle(() => {
      if (phoneClassTouch) {
        import('@lib/seatCounter')
          .then((seats) => safe('seatCounter', () => seats.initSeatCounter()))
          .catch((err) => console.error('[KR8] seatCounter import failed:', err));
        return;
      }

      // Aurora is an enhancement on top of a complete CSS field, so it
      // waits for idle and self-gates on device class inside.
      import('@lib/auroraField')
        .then((m) => safe('auroraField', () => m.initAuroraField()))
        .catch(() => { /* CSS field is the design; nothing to report */ });

      void Promise.all([
        import('@lib/cursorTrail'),
        import('@lib/whiteLight'),
        import('@lib/kineticType'),
        import('@lib/asciiDither'),
        import('@lib/seatCounter'),
        import('@lib/cardTilt')
      ]).then(([trail, white, kinetic, ascii, seats, tilt]) => {
        safe('cursorTrail', () => trail.initCursorTrail());
        safe('whiteLight',  () => white.initWhiteLight());
        safe('kineticType', () => kinetic.initKineticType());
        safe('asciiDither', () => ascii.initAsciiDither());
        safe('seatCounter', () => seats.initSeatCounter());
        safe('cardTilt',    () => tilt.initCardTilt());
      }).catch((err) => {
        console.error('[KR8] deferred visual inits failed:', err);
      });
    });

    // HYBRID nav system (3 layers) — isolated so stale GSAP/Lenis
    // cache in the earlier block never blocks the menu.
    safe('oracle',           () => initOracle());
    safe('kintsugi',         () => initKintsugi());
    safe('multiStateNav',    () => initMultiStateNav());

    // Theme toggle lives in @lib/theme — persists + respects system pref
    import('@lib/theme').then((m) => safe('theme', () => m.initTheme()));

    if (import.meta.env.DEV) {
      console.log('%c[KR8TIV / PRISM · 08] 侍 — astro build', 'color:#ff6ad5;font:600 12px monospace');
      console.log('%c↳ Press W for white light', 'color:#f2f1ec;font:400 11px monospace');
    }
  </script>
</body>
</html>
