---
/**
 * SeatCounter — small pulsing "N slots open · Q3 2026" pill.
 *
 * Populated client-side by `initSeatCounter()` from the editable
 * /availability.json. The evergreen fallback is inlined here as a data
 * attribute so the pill reads honestly even before (or without) the
 * fetch — see src/lib/seatCounter.ts for the staleness rules.
 *
 * Usage: <SeatCounter /> or <SeatCounter size="large" mode="current" />
 */
export interface Props {
  size?: 'small' | 'large';
  mode?: 'current' | 'next';
  id?: string;
}
const { size = 'small', mode = 'current', id } = Astro.props;
const EVERGREEN = 'Booking selectively · 2–3 engagements at a time';
---
<span
  class={`seat-counter seat-${size}`}
  id={id}
  data-seat-counter={mode}
  data-seat-evergreen={EVERGREEN}
  role="status"
><span class="seat-dot" aria-hidden="true"></span><span class="seat-text">{EVERGREEN}</span></span>

<style>
  .seat-counter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink);
    background: rgba(242, 241, 236, .03);
    border: 1px solid rgba(242, 241, 236, .12);
    padding: 10px 16px;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    line-height: 1;
  }
  .seat-counter.seat-large {
    padding: 14px 22px;
    font-size: 12.5px;
    letter-spacing: .26em;
    gap: 14px;
  }
  .seat-counter :global(.seat-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25d366;  /* live green */
    box-shadow: 0 0 8px rgba(37, 211, 102, .7);
    animation: seat-breathe 2.2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes seat-breathe {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.4); opacity: .55; }
  }
  @media (prefers-reduced-motion: reduce) { .seat-counter :global(.seat-dot) { animation: none; } }
  html.motion-off .seat-counter :global(.seat-dot) { animation: none; }

  .seat-counter :global(.seat-num) {
    color: var(--accent-1);
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.4em;
    letter-spacing: 0;
    margin-right: 4px;
    animation: seat-num-pulse 4s ease-in-out infinite;
  }
  @keyframes seat-num-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) { .seat-counter :global(.seat-num) { animation: none; } }
  html.motion-off .seat-counter :global(.seat-num) { animation: none; }

  .seat-counter :global(.seat-q) { color: var(--accent-4); }
  .seat-counter :global(.seat-meta) {
    color: var(--ink-muted);
    font-size: .85em;
    opacity: .7;
  }

  @media (max-width: 640px) {
    .seat-counter :global(.seat-meta) { display: none; }
  }

  /* Small iPhones: at .22em tracking "1 SLOT OPEN · Q3 2026" is wider
     than a 320px screen minus the pill's own padding, so it wrapped and
     left "2026" stranded on its own line under the year it belongs to.
     Tighter tracking + a smaller face keeps the whole claim on one
     line, which is the point of a pill. */
  @media (max-width: 430px) {
    .seat-counter {
      font-size: 10.5px;
      letter-spacing: .12em;
      padding: 9px 14px;
      gap: 8px;
      max-width: calc(100vw - 40px);
    }
    .seat-counter.seat-large {
      font-size: 11px;
      letter-spacing: .14em;
      padding: 12px 18px;
      gap: 10px;
    }
    /* Only the quarter label is protected from breaking — that was the
       actual complaint ("Q3" on one line, "2026" stranded on the next).
       Do NOT nowrap .seat-text: it also carries the evergreen fallback
       sentence ("Booking selectively · 2–3 engagements at a time"),
       which is ~383px unbroken and pushed the body 34px past the
       viewport on WebKit at 375 and 414. Whichever string is in the DOM
       when you measure decides whether you see the bug — which is why
       it looked intermittent. */
    .seat-counter :global(.seat-q) { white-space: nowrap; }
    .seat-counter :global(.seat-text) { min-width: 0; }
  }
</style>
