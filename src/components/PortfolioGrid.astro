---
import cards from '../data/gallery.json';
interface Props { teaser?: boolean }
const {teaser=false}=Astro.props;
const items=teaser?cards.slice(0,4):cards;
---
<div class="portfolio-grid">
{items.map(p=>(
<article class="portfolio-card" id={`sel-${p.name.toLowerCase().replace(/[^a-z0-9]+/g,'-')}`}>
<a class="portfolio-image" href={teaser?'/work/':p.url} target={!teaser&&p.url.startsWith('http')?'_blank':undefined} rel={!teaser&&p.url.startsWith('http')?'noopener noreferrer':undefined} aria-label={`${p.name} — ${p.category.includes('BUSINESS')?'view artwork':'visit website'}`}>
<img src={p.poster} alt={p.alt} width="1600" height="1000" loading={p.category.includes('BUSINESS CARDS') ? 'eager' : 'lazy'} decoding="async" />
{p.video&&<video muted loop playsinline preload="none" poster={p.poster} data-gallery-video data-src={p.video} aria-hidden="true" hidden></video>}
</a>
<div class="portfolio-copy"><p class="portfolio-type">{p.category}</p><h3>{p.name}</h3><p>{p.description}</p><a class="portfolio-link" href={teaser?'/work/':p.url} target={!teaser&&p.url.startsWith('http')?'_blank':undefined} rel={!teaser&&p.url.startsWith('http')?'noopener noreferrer':undefined}>{p.category.includes('STAGING')?'View staging':p.category.includes('BUSINESS')?'View design':'View project'} ↗</a></div>
</article>
))}
</div>
<style>
.portfolio-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}.portfolio-card{min-width:0;overflow:hidden;background:#17171b!important;border:1px solid #59555e;border-radius:8px;box-shadow:0 16px 40px rgba(0,0,0,.22);mask-image:none!important;-webkit-mask-image:none!important;isolation:isolate}.portfolio-image{position:relative;display:block;aspect-ratio:16/10;background:#111113;overflow:hidden;mask-image:none!important;-webkit-mask-image:none!important}.portfolio-image img{width:100%;height:100%;display:block;object-fit:contain;filter:none!important;opacity:1!important;mix-blend-mode:normal!important;mask-image:none!important;-webkit-mask-image:none!important}.portfolio-copy{padding:26px;background:#17171b;color:#f2f1ec}.portfolio-type{font:10px/1.5 'JetBrains Mono',monospace;letter-spacing:.16em;color:#ffcd85;margin:0 0 14px}.portfolio-copy h3{font:38px/1.1 'Instrument Serif',serif;margin:0 0 16px;color:#f2f1ec}.portfolio-copy>p:not(.portfolio-type){font:15px/1.65 'Inter Tight',sans-serif;color:#cfcbd0;margin:0 0 22px}.portfolio-link{font:11px/1.5 'JetBrains Mono',monospace;letter-spacing:.1em;color:#ffcd85;text-decoration:underline;text-underline-offset:5px}.portfolio-image video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:1;filter:none;mix-blend-mode:normal;mask-image:none;background:#111113}.portfolio-image video[hidden]{display:none}.portfolio-image:focus-visible,.portfolio-link:focus-visible{outline:3px solid #ffcd85;outline-offset:3px}@media(max-width:720px){.portfolio-grid{grid-template-columns:minmax(0,1fr);gap:24px}.portfolio-copy{padding:22px}.portfolio-copy h3{font-size:34px}}
</style>

<script>
const videos=document.querySelectorAll<HTMLVideoElement>('[data-gallery-video]');
const mq=matchMedia('(prefers-reduced-motion: reduce)');
const size=matchMedia('(min-width: 768px) and (pointer: fine)');
const conn=(navigator as Navigator&{connection?:{saveData?:boolean}}).connection;
const allowed=()=>!mq.matches&&size.matches&&!conn?.saveData&&!document.documentElement.classList.contains('motion-off')&&!document.hidden;
const stop=(v:HTMLVideoElement)=>{v.pause();v.hidden=true};
videos.forEach(v=>{const card=v.closest('.portfolio-card');card?.addEventListener('pointerenter',()=>{if(!allowed())return;if(!v.src&&v.dataset.src){v.src=v.dataset.src;v.load()}v.muted=true;v.play().then(()=>{if(allowed()&&card?.matches(':hover'))v.hidden=false;else stop(v)}).catch(()=>stop(v))});card?.addEventListener('pointerleave',()=>stop(v))});
const stopAll=()=>videos.forEach(stop);mq.addEventListener('change',stopAll);size.addEventListener('change',stopAll);document.addEventListener('visibilitychange',()=>{if(document.hidden)stopAll()});new MutationObserver(()=>{if(!allowed())stopAll()}).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
const io=new IntersectionObserver(entries=>{for(const e of entries)if(!e.isIntersecting)stop(e.target as HTMLVideoElement)});videos.forEach(v=>io.observe(v));
</script>
