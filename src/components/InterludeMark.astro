---
// Nov 9 2026: the interlude plays the ORIGINAL supplied loop (Design-29-2-1.mp4),
// black ground and all. The Nov 8 keyed/alpha derivative
// (kr8tiv-chrome-transparent.webm/.webp) stripped the near-black edges of the
// chrome along with the backdrop, so the letters read chopped and weathered.
// That derivative stays in the repo, unused. The black is now blended OUTWARD by
// `.interlude-halo` (see blend.css): a pure-black core that covers the whole media
// rectangle, then feathers into the page only OUTSIDE the animation's bounds.
// Nothing masks, filters or overlays the animation itself.
// The still is the original supplied poster, a real image independent of the
// video's loading/play state.
const poster = '/kr8tiv-assets/posters/Design-29-2-1.webp';
---
<div class="interlude-frame" data-interlude-black>
  <span class="interlude-halo" aria-hidden="true"></span>
  <img src={poster} alt="KR8TIV chrome wordmark" width="960" height="236" loading="eager" decoding="async" />
  <video data-interlude-video data-src="/kr8tiv-assets/Design-29-2-1.mp4?v=3" muted loop playsinline preload="none" poster={poster} aria-hidden="true"></video>
</div>
<script>
const video=document.querySelector<HTMLVideoElement>('[data-interlude-video]');
const frame=video?.closest<HTMLElement>('.interlude-frame');
if(video&&frame){
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const connection=(navigator as Navigator&{connection?:{saveData?:boolean}}).connection;
  let visible=false;
  const allowed=()=>visible&&!reduced.matches&&!connection?.saveData&&!document.hidden&&!document.documentElement.classList.contains('motion-off');
  const showPoster=()=>frame.classList.remove('is-playing');
  const sync=()=>{
    if(!allowed()){video.pause();showPoster();return;}
    if(!video.getAttribute('src')&&video.dataset.src){video.src=video.dataset.src;video.load();}
    video.muted=true;
    video.play().catch(showPoster);
  };
  video.addEventListener('playing',()=>{
    const reveal=()=>{
      if(!allowed()||video.paused||video.readyState<2)return;
      frame.classList.add('is-playing');
    };
    // Do not hide the image until a decoded video frame is actually ready to paint.
    if('requestVideoFrameCallback' in video)video.requestVideoFrameCallback(reveal);
    else requestAnimationFrame(reveal);
  });
  ['waiting','error','emptied','pause'].forEach(event=>video.addEventListener(event,showPoster));
  reduced.addEventListener('change',sync);
  document.addEventListener('visibilitychange',sync);
  new MutationObserver(sync).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
  const observer=new IntersectionObserver(entries=>{visible=entries.some(e=>e.isIntersecting);sync();},{threshold:.1});
  observer.observe(frame);
}
</script>
