---
---
<section class="reel" id="reel">
  <div class="reel-pin">
    <div class="reel-bg">
      <video muted loop playsinline preload="none" poster="/kr8tiv-assets/posters/forrestbackground.webp">
        <source src="/kr8tiv-assets/forrestbackground.mp4?v=2" type="video/mp4" />
      </video>
      <span class="reel-fade-top"   aria-hidden="true"></span>
      <span class="reel-fade-bot"   aria-hidden="true"></span>
    </div>
    <div class="reel-inner">
      <div class="reel-stage">
        <div class="reel-eye mono"><span class="b"></span>VI / ATMOSPHERE · REFRACTIVE FIELD</div>
        <h2 class="serif reel-katana-title" id="reel-katana-title">
          <span class="rk-wrap" id="rk-wrap">
            <span class="rk-sr">Death to <em>generic.</em></span>
          </span>
        </h2>
        <p class="reel-sub reel-sub-fine mono" aria-hidden="true">SWEEP CURSOR TO SLASH THE PRISM</p>
        <p class="reel-sub reel-sub-coarse mono">CRAFTED IN EDMONTON · BUILT TO OUTLAST TRENDS</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Forest video bleeds into surrounding chapters via blend.css masks;
     video is pre-scaled 1.08 in core.css to keep corner artifacts out. */
  .reel { background: #000; }
  .reel-bg { isolation: isolate; }
  .reel-fade-top,
  .reel-fade-bot {
    position: absolute;
    left: 0; right: 0;
    height: 26vh;
    pointer-events: none;
    z-index: 1;
  }
  .reel-fade-top {
    top: 0;
    background: linear-gradient(to bottom,
      #000 0%, rgba(0,0,0,.92) 28%, rgba(0,0,0,.55) 60%,
      rgba(0,0,0,.18) 86%, transparent 100%);
  }
  .reel-fade-bot {
    bottom: 0;
    background: linear-gradient(to top,
      #000 0%, rgba(0,0,0,.92) 28%, rgba(0,0,0,.55) 60%,
      rgba(0,0,0,.18) 86%, transparent 100%);
  }

  .reel-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    pointer-events: none;
    user-select: none;
  }
  .reel-eye {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    letter-spacing: .34em;
    text-transform: uppercase;
    color: rgba(242, 241, 236, .78);
    text-shadow: 0 1px 8px rgba(0, 0, 0, .65);
  }
  .reel-eye .b {
    width: 40px;
    height: 1px;
    background: var(--accent-1);
  }
  .reel-katana-title {
    --slash-x: 0px;
    --seam-op: 0;
    position: relative;
    text-shadow: 0 8px 40px rgba(0, 0, 0, .55);
  }
  .rk-wrap {
    position: relative;
    display: inline-block;
    padding: .06em .12em;
  }
  .rk-sr {
    display: inline-block;
  }
  :global(.rk-wrap.is-split) .rk-sr {
    opacity: 0;
  }
  :global(.rk-slice) {
    position: absolute;
    inset: .06em .12em;
    white-space: nowrap;
    will-change: transform;
    transition: transform .18s cubic-bezier(.16, 1, .3, 1);
    pointer-events: none;
  }
  :global(.rk-top) {
    clip-path: inset(-12% -10% 49% -10%);
    transform: translate3d(var(--slash-x), 0, 0);
  }
  :global(.rk-bot) {
    clip-path: inset(50% -10% -18% -10%);
    transform: translate3d(calc(var(--slash-x) * -1), 0, 0);
  }
  :global(.rk-seam) {
    position: absolute;
    left: -6%;
    right: -6%;
    top: 50.5%;
    height: 1.5px;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, .95) 35%, var(--accent-1) 50%, rgba(255, 209, 102, .9) 65%, transparent 100%);
    box-shadow: 0 0 18px rgba(255, 106, 213, .85), 0 0 36px rgba(255, 45, 74, .5);
    opacity: var(--seam-op);
    transform: rotate(-1.4deg);
    transition: opacity .28s ease-out;
    pointer-events: none;
  }
  :global(html.motion-off .rk-wrap.is-split) .rk-sr {
    opacity: 1;
  }
  :global(html.motion-off .rk-slice),
  :global(html.motion-off .rk-seam) {
    display: none;
  }

  .reel-sub {
    margin: 4px 0 0;
    font-size: 10px;
    letter-spacing: .34em;
    text-transform: uppercase;
    color: rgba(242, 241, 236, .72);
    text-shadow: 0 1px 8px rgba(0, 0, 0, .7);
  }
  .reel-sub-coarse { display: none; }
  @media (pointer: coarse) {
    .reel-sub-fine { display: none; }
    .reel-sub-coarse { display: block; }
  }

  :global(html[data-theme="light"]) .reel-eye,
  :global(html[data-theme="light"]) .reel-sub {
    color: rgba(26, 24, 32, .74);
    text-shadow: 0 1px 0 rgba(255, 255, 255, .65);
  }
  :global(html[data-theme="light"]) .reel-katana-title {
    text-shadow: 0 4px 24px rgba(245, 242, 234, .7);
  }
</style>

<script>
  import { isPhoneClassTouch } from '@lib/devicePolicy';
  // Skip the pin on mobile — responsive.css lays the reel out as a
  // normal block so no ScrollTrigger pinSpacer is needed.
  const reelMobile =
    window.matchMedia('(max-width: 720px)').matches ||
    isPhoneClassTouch();
  if (document.querySelector('.reel')) {
    if (!reelMobile) {
      Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([gsapMod, stMod]) => {
        const gsap = gsapMod.gsap;
        const ScrollTrigger = stMod.ScrollTrigger;
        gsap.registerPlugin(ScrollTrigger);
        ScrollTrigger.create({
          trigger: '.reel', start: 'top top', end: 'bottom bottom',
          pin: '.reel-pin', pinSpacing: false
        });
        gsap.fromTo('.reel-bg video',
          { scale: 1.08 },
          { scale: 1.18, ease: 'none',
            scrollTrigger: { trigger: '.reel', start: 'top top', end: 'bottom top', scrub: true }
          });
      }).catch((err) => console.error('[KR8·reel] GSAP import failed:', err));
    }
  }

  // Cursor-drawn katana trail + three.js reel scene are deferred until
  // this section approaches the viewport. This keeps heavy GL setup out
  // of the initial home-page boot path.
  const reelPin = document.querySelector<HTMLElement>('.reel-pin');
  const katanaTitle = document.getElementById('reel-katana-title');
  const rkWrap = document.getElementById('rk-wrap');
  if (
    reelPin &&
    katanaTitle &&
    rkWrap &&
    !reelMobile &&
    window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches
  ) {
    const srcHtml = rkWrap.querySelector('.rk-sr')?.innerHTML ?? '';
    if (srcHtml) {
      const top = document.createElement('span');
      top.className = 'rk-slice rk-top';
      top.setAttribute('aria-hidden', 'true');
      top.innerHTML = srcHtml;
      const seam = document.createElement('span');
      seam.className = 'rk-seam';
      seam.setAttribute('aria-hidden', 'true');
      const bot = document.createElement('span');
      bot.className = 'rk-slice rk-bot';
      bot.setAttribute('aria-hidden', 'true');
      bot.innerHTML = srcHtml;
      rkWrap.append(top, seam, bot);
      rkWrap.classList.add('is-split');
    }
    let lastX = 0;
    let settleTimer = 0;
    reelPin.addEventListener('pointermove', (e: PointerEvent) => {
      if (document.documentElement.classList.contains('motion-off')) return;
      const dx = lastX ? e.clientX - lastX : 0;
      lastX = e.clientX;
      const shear = Math.max(-14, Math.min(14, dx * 0.42));
      const energy = Math.min(1, Math.abs(dx) / 26);
      katanaTitle.style.setProperty('--slash-x', `${shear.toFixed(1)}px`);
      katanaTitle.style.setProperty('--seam-op', energy > 0.14 ? energy.toFixed(2) : '0');
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        katanaTitle.style.setProperty('--slash-x', '0px');
        katanaTitle.style.setProperty('--seam-op', '0');
      }, 140);
    }, { passive: true });
  }
  if (reelPin && !reelMobile) {
    let fxBooted = false;
    const bootReelFx = (): void => {
      if (fxBooted) return;
      fxBooted = true;
      import('@lib/katanaTrail').then(({ initKatanaTrail }) => {
        try {
          initKatanaTrail(reelPin, {
            color:           [1.0, 0.55, 0.86],
            trailFade:       0.93,
            brushSize:       11,
            chromaticOffset: 6,
            velocityBoost:   85
          });
        } catch (err) {
          console.error('[KR8·reel] katanaTrail init failed:', err);
        }
      }).catch((err) => console.error('[KR8·reel] katanaTrail import failed:', err));

      // Three.js layered scene: volumetric prism slab + refractive
      // mirror lake. Both sample the same forest VideoTexture.
      import('@lib/reelScene').then(({ initReelScene }) => {
        const video = reelPin.querySelector<HTMLVideoElement>('.reel-bg video');
        if (!video) return;
        // Wait for first frame so VideoTexture has data to sample.
        const start = (): void => {
          try {
            initReelScene(reelPin, video, {
              slabTint:       [1.0, 0.55, 0.86],
              lakeTint:       [0.92, 0.62, 0.95],
              slabDispersion: 0.018,
              lakeRipple:     0.045
            });
          } catch (err) {
            console.error('[KR8·reel] reelScene init failed:', err);
          }
        };
        if (video.readyState >= 2) start();
        else video.addEventListener('loadeddata', start, { once: true });
      }).catch((err) => console.error('[KR8·reel] reelScene import failed:', err));
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          bootReelFx();
        }
      }, { rootMargin: '320px 0px', threshold: 0.01 });
      io.observe(reelPin);
    } else {
      bootReelFx();
    }
  }
</script>
