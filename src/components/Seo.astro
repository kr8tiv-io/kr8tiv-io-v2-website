---
/**
 * Seo.astro — comprehensive SEO + AI-SEO (LLMO/GEO) meta block.
 *
 * Usage:
 *   <Seo
 *     title="..."
 *     description="..."
 *     canonical="/process/"
 *     ogImage="/og/process.jpg"
 *     type="WebPage"
 *     breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Process', url: '/process/' }]}
 *     faqs={[{ q: '…', a: '…' }]}
 *     howTo={{ name: '…', steps: [{ name, text }] }}
 *     noIndex={false}
 *   />
 *
 * What this emits:
 *   · Primary <title> + <meta description>
 *   · Open Graph (og:*) for Facebook / LinkedIn / iMessage / Slack
 *   · Twitter Cards (twitter:*) for X.com rendering
 *   · Canonical link + robots meta + theme-color + author
 *   · JSON-LD structured data:
 *       - Organization (sitewide brand)
 *       - WebSite (with SearchAction for Google sitelinks search box)
 *       - ProfessionalService (our offering)
 *       - WebPage / ContactPage / AboutPage (per-page override)
 *       - BreadcrumbList (if provided)
 *       - HowTo (if provided — for the /process/ page)
 *       - FAQPage (if provided)
 *       - Person (Matt, founder)
 *
 * Why each matters:
 *   · Organization + Logo → unlocks rich brand panels in SERP
 *   · WebSite + SearchAction → Google sitelinks search box on brand search
 *   · HowTo → eligible for rich results + cited heavily by AI engines
 *     (ChatGPT / Perplexity / Gemini / Claude) when explaining process
 *   · FAQPage → still used by AI engines as canonical Q&A source even
 *     after Google deprecated the rich-results badge
 *   · BreadcrumbList → Google renders breadcrumbs in SERP + AI uses
 *     them to understand site structure
 *   · Person (author) → E-E-A-T signal; AI engines prefer content with
 *     named, verifiable authors
 */

export interface FaqItem { q: string; a: string; }
export interface HowToStep { name: string; text: string; image?: string; }
export interface Crumb { name: string; url: string; }

export interface Props {
  title: string;
  description: string;
  canonical?: string;               // absolute or relative; we normalize to absolute
  ogImage?: string;                 // relative ok, normalized to absolute
  ogImageAlt?: string;
  type?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'Article' | 'CaseStudy';
  article?: { publishedTime?: string; modifiedTime?: string; author?: string; section?: string; tags?: string[]; wordCount?: number; images?: string[] };
  breadcrumbs?: Crumb[];
  faqs?: FaqItem[];
  howTo?: { name: string; description: string; totalTime?: string; steps: HowToStep[] };
  noIndex?: boolean;
  keywords?: string[];              // optional — low SEO value but some AI crawlers still parse
}

const {
  title,
  description,
  canonical,
  /* Default OG card — v2, designed 2026-08-12. The v1 card composited
     the jagged pixel-trace logo (outline runoff, muddy fills). v2 is
     rendered from the true-vector mark (kr8tiv-logo-clean.svg) with the
     site's own tokens: Instrument Serif italic hero line, JetBrains
     Mono tracked labels, ink #f2f1ec on #050507, prism-gradient rule.
     New filename on purpose: X/Facebook cache og:image by URL, so a
     changed file at the old path would keep serving the old card. */
  ogImage = '/kr8tiv-assets/og-card-v2.png',
  ogImageAlt = 'KR8TIV, an Edmonton design studio for websites, branding and signage',
  type = 'WebPage',
  article,
  breadcrumbs,
  faqs,
  howTo,
  noIndex = false,
  keywords
} = Astro.props;

// Resolve everything to an absolute URL against the configured `site`.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kr8tiv.io';
const canonicalUrl = canonical
  ? (canonical.startsWith('http') ? canonical : siteUrl + canonical)
  : siteUrl + Astro.url.pathname;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;

/* ------------------- BUILD STAMP -------------------
   Deploy verification has to answer "is the origin serving the build I
   just pushed?", and matching on copy strings only ever gives a guess —
   a phrase can exist in two builds, and a cache can serve a mix. This is
   an exact answer. scripts/verify-live.mjs reads this meta tag from the
   live URL and compares it to the local dist; anything else is a stale
   cache or a partial upload, and it says so instead of shrugging.
   CI passes the commit SHA; local builds fall back to a timestamp. */
const BUILD_ID = (
  import.meta.env.PUBLIC_BUILD_ID ||
  `local-${new Date().toISOString().slice(0, 16).replace(/[-:T]/g, '')}`
).slice(0, 16);

// ------------------- JSON-LD blocks -------------------

// Sitewide Organization — appears on every page so Google can
// consolidate signals under one @id.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': siteUrl + '/#organization',
  name: 'KR8TIV',
  alternateName: ['KR8TIV Atelier', 'Kr8tiv', 'KR8TiV'],
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    '@id': siteUrl + '/#logo',
    url: siteUrl + '/kr8tiv-assets/kr8tiv-logo-schema.png',
    contentUrl: siteUrl + '/kr8tiv-assets/kr8tiv-logo-schema.png',
    width: 600,
    height: 600,
    caption: 'KR8TIV'
  },
  image: siteUrl + '/kr8tiv-assets/kr8tiv-logo-schema.png',
  description: 'KR8TIV is an Edmonton, Alberta creative studio building brands, websites, signage, packaging, motion and marketing for businesses that want to be memorable, not generic.',
  slogan: 'Built for founders who\'d rather start a cult than a brand.',
  founder: {
    '@type': 'Person',
    '@id': siteUrl + '/#matt',
    name: 'Matt Haynes',
    jobTitle: 'Founder & Creative Director',
    url: siteUrl + '/#why'
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Edmonton',
    addressRegion: 'AB',
    addressCountry: 'CA'
  },
  areaServed: [
    { '@type': 'Place', name: 'Edmonton, Alberta' },
    { '@type': 'Place', name: 'Sherwood Park, Alberta' },
    { '@type': 'Place', name: 'St. Albert, Alberta' },
    { '@type': 'Place', name: 'Spruce Grove, Alberta' },
    { '@type': 'Place', name: 'Leduc, Alberta' },
    { '@type': 'Place', name: 'Alberta, Canada' },
    { '@type': 'Place', name: 'Canada' },
    { '@type': 'Place', name: 'Worldwide' }
  ],
  knowsAbout: [
    'Brand Design', 'Web Design', 'Motion Design', 'Video Editing',
    'AI Automation', 'AI Marketing', 'AI Business Solutions',
    'Creative Direction', 'User Experience', 'Art Direction',
    'Ecommerce Design', 'Packaging Design', '3D Design', 'Product Design'
  ],
  contactPoint: [{
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: '+1-780-915-5471',
    email: 'matt@kr8tiv.io',
    url: 'https://calendly.com/kr8tiv',
    availableLanguage: ['en']
  }],
  /* Removed instagram + x.com per user request — those accounts
     don't currently link to live profiles. LinkedIn (company) +
     calendly + GitHub stay as the canonical external presence. */
  sameAs: [
    'https://calendly.com/kr8tiv',
    'https://github.com/kr8tiv-io',
    'https://www.linkedin.com/company/kr8tiv-agency',
    'https://g.page/r/Cf3IkEeasCMiEBM'
  ]
};

// ProfessionalService — declares us as a bookable service provider.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'LocalBusiness'],
  '@id': siteUrl + '/#service',
  name: 'KR8TIV',
  alternateName: ['Kr8tiv', 'KR8TIV Design Atelier'],
  description: 'KR8TIV (Kr8tiv on Google) is an Edmonton marketing agency and creative studio: website design, graphic design, video production and internet marketing for businesses in Edmonton, Sherwood Park, St. Albert, Spruce Grove and across Canada.',
  url: siteUrl,
  image: ogImageUrl,
  logo: { '@id': siteUrl + '/#logo' },
  telephone: '+1-780-915-5471',
  hasMap: 'https://g.page/r/Cf3IkEeasCMiEBM',
  email: 'matt@kr8tiv.io',
  /* Service-area business: no public street address, matching the
     Google Business Profile. City/region only. */
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Edmonton',
    addressRegion: 'AB',
    addressCountry: 'CA'
  },
  /* Hours as published on the Google Business Profile (and shown in the footer). */
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00'
  }],
  /* Google Business Profile categories: primary first. */
  knowsAbout: ['Marketing agency', 'Graphic designer', 'Website designer', 'Video production service', 'Internet marketing service'],
  areaServed: [
    { '@type': 'City', name: 'Edmonton', containedInPlace: { '@type': 'AdministrativeArea', name: 'Alberta' } },
    { '@type': 'City', name: 'Sherwood Park', containedInPlace: { '@type': 'AdministrativeArea', name: 'Alberta' } },
    { '@type': 'City', name: 'St. Albert', containedInPlace: { '@type': 'AdministrativeArea', name: 'Alberta' } },
    { '@type': 'City', name: 'Spruce Grove', containedInPlace: { '@type': 'AdministrativeArea', name: 'Alberta' } },
    { '@type': 'Country', name: 'Canada' }
  ],
  sameAs: [
    'https://calendly.com/kr8tiv',
    'https://github.com/kr8tiv-io',
    'https://www.linkedin.com/company/kr8tiv-agency',
    'https://g.page/r/Cf3IkEeasCMiEBM'
  ],
  serviceType: [
    'Brand Identity Design',
    'Website Design & Development',
    'Storefront Design',
    'Graphic Design',
    'Packaging Design',
    'Search Engine Optimization',
    'AI Search Optimization',
    'Motion & 3D Design',
    'Video Production',
    'AI Marketing Automation',
    'AI Business Solutions',
    'AI Agents & Internal Tools',
    'AI Automation'
  ],
  provider: { '@id': siteUrl + '/#organization' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'KR8TIV services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Brand Identity' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website Design & Build' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Motion & 3D' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Marketing Automation' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Business Solutions' } }
    ]
  }
};

// WebSite + SearchAction — unlocks the Google sitelinks search box
// on brand queries (`KR8TIV …`).
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': siteUrl + '/#website',
  url: siteUrl,
  name: 'KR8TIV',
  description: 'KR8TIV, an Edmonton design studio. Brands, websites, signage, packaging, motion and marketing.',
  publisher: { '@id': siteUrl + '/#organization' },
  inLanguage: 'en-CA'
};

// Per-page node. Articles and case studies are BlogPosting (a valid
// schema.org type; "CaseStudy" is not one) with a named Person author,
// the Organization as publisher, and real publish/modified dates.
const isArticle = type === 'Article' || type === 'CaseStudy';
const isoDate = (d?: string) => d; // frontmatter dates are ISO 8601 (YYYY-MM-DD)
const pageSchemaType = isArticle ? 'BlogPosting' : type;
const pageSchema = isArticle ? {
  '@context': 'https://schema.org',
  '@type': pageSchemaType,
  '@id': canonicalUrl + '#article',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  url: canonicalUrl,
  headline: title.replace(/\s*\|\s*KR8TIV$/, '').slice(0, 110),
  name: title,
  description,
  image: [ogImageUrl, ...((article?.images ?? []).map((i) => (i.startsWith('http') ? i : siteUrl + i)))],
  inLanguage: 'en-CA',
  isPartOf: { '@id': siteUrl + '/#website' },
  ...(article?.publishedTime && { datePublished: isoDate(article.publishedTime) }),
  ...(article?.publishedTime && { dateModified: isoDate(article.modifiedTime ?? article.publishedTime) }),
  author: {
    '@type': 'Person',
    '@id': siteUrl + '/#matt',
    name: 'Matt Haynes',
    url: siteUrl + '/#why',
    jobTitle: 'Founder & Creative Director',
    sameAs: ['https://www.linkedin.com/in/matthaynes88/']
  },
  publisher: {
    '@type': 'Organization',
    '@id': siteUrl + '/#organization',
    name: 'KR8TIV',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: siteUrl + '/kr8tiv-assets/kr8tiv-logo-schema.png', width: 600, height: 600 }
  },
  ...(article?.section && { articleSection: article.section }),
  ...(article?.tags?.length && { keywords: article.tags.join(', ') }),
  ...(article?.wordCount && { wordCount: article.wordCount }),
  about: { '@id': siteUrl + '/#service' },
  spatialCoverage: { '@type': 'Place', name: 'Edmonton, Alberta, Canada' }
} : {
  '@context': 'https://schema.org',
  '@type': pageSchemaType,
  '@id': canonicalUrl + '#webpage',
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { '@id': siteUrl + '/#website' },
  about: { '@id': siteUrl + '/#organization' },
  inLanguage: 'en-CA',
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl }
};

// BreadcrumbList — lightweight nav trail. SeaOcean SEO audit
// flagged the homepage as missing BreadcrumbList; ensure every
// page emits at least a single-item crumb (Home) when the caller
// doesn't pass a richer trail. Pages that DO pass `breadcrumbs`
// (process, work, terms, start, build-notes) keep their multi-step
// trails; only the homepage default is the single Home anchor.
const effectiveCrumbs = (breadcrumbs && breadcrumbs.length > 0)
  ? breadcrumbs
  : [{ name: 'Home', url: '/' }];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: effectiveCrumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.url.startsWith('http') ? c.url : siteUrl + c.url
  }))
};

// FAQ schema — still eligible for AI-engine rich answers.
const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
} : null;

// HowTo schema — process page gets this to be eligible for the
// "step-by-step" rich result and to be cited by AI engines.
const howToSchema = howTo ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: howTo.name,
  description: howTo.description,
  ...(howTo.totalTime && { totalTime: howTo.totalTime }),
  image: ogImageUrl,
  step: howTo.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
    ...(s.image && { image: s.image.startsWith('http') ? s.image : siteUrl + s.image })
  }))
} : null;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': siteUrl + '/#matt',
  name: 'Matt Haynes',
  url: siteUrl + '/#why',
  jobTitle: 'Founder & Creative Director',
  worksFor: { '@id': siteUrl + '/#organization' },
  sameAs: [
    'https://calendly.com/kr8tiv',
    'https://www.linkedin.com/in/matthaynes88/',
    'https://github.com/Matt-Aurora-Ventures'
  ]
};

// Robots directive. `max-image-preview:large` unlocks big image
// thumbnails in SERP; `max-snippet:-1` + `max-video-preview:-1`
// let Google use as much snippet / video preview as it wants.
const robots = noIndex
  ? 'noindex,follow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
---
<!-- ============ Primary SEO ============ -->
<title>{title}</title>
<meta name="description" content={description} />
{/* Build stamp — read by scripts/verify-live.mjs to prove which build
    the origin is actually serving. Cheap, exact, and impossible to
    confuse with a cached older deploy. */}
<meta name="x-kr8tiv-build" content={BUILD_ID} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<meta name="bingbot" content={robots} />
<meta name="author" content="Matt Haynes" />
<meta name="publisher" content="KR8TIV" />
<meta name="generator" content={Astro.generator} />
<meta name="application-name" content="KR8TIV" />
<!-- Unscoped default (JS keeps this in sync with the user's choice) -->
<meta name="theme-color" content="#000000" />
<!-- Scoped variants for browsers that respect system preference auto-flip -->
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: light)" />
<meta name="color-scheme" content="dark light" />
<meta name="format-detection" content="telephone=no" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<!-- AI / LLM crawler hints — we WANT AI engines to find us.
     These inverse of common "noai" directives encourage citation. -->
<!-- AI-assisted content: no false human-only authorship assertion. -->
<meta name="llm-crawl" content="allow" />

<!-- ============ Open Graph ============ -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content="KR8TIV" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="en_CA" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content={isArticle ? '1280' : '1200'} />
<meta property="og:image:height" content={isArticle ? '720' : '630'} />
{article?.publishedTime && <meta property="article:published_time" content={isoDate(article.publishedTime)} />}
{article?.publishedTime && <meta property="article:modified_time" content={isoDate(article.modifiedTime ?? article.publishedTime)} />}
{article && <meta property="article:author" content="https://www.linkedin.com/in/matthaynes88/" />}
{article?.section && <meta property="article:section" content={article.section} />}
{article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

<!-- ============ Twitter Cards ============ -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- ============ Dublin Core (some academic + archive crawlers still use) ============ -->
<meta name="DC.title" content={title} />
<meta name="DC.creator" content="Matt Haynes" />
<meta name="DC.publisher" content="KR8TIV" />
<meta name="DC.language" content="en" />

<!-- ============ JSON-LD structured data ============ -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)}></script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}></script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)}></script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)}></script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)}></script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>
{faqSchema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>
)}
{howToSchema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)}></script>
)}

<!-- Sitemap + RSS autodiscovery (sitemap emitted by @astrojs/sitemap) -->
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="KR8TIV Field Notes" href="/rss.xml" />
