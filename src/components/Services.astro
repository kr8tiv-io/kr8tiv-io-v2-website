---
/**
 * Services — 12 panels rendered server-side from SERVICES data.
 * Horizontal GSAP pin attaches client-side.
 */
import { SERVICES, vv, videoPoster, disciplineLoop } from '@lib/content';
---
<section class="services" id="services">
  <div class="services-intro">
    <div class="wrap">
      <div class="services-intro-inner">
        <div>
          <div class="chapter-label mono"><span class="b"></span>II / CAPABILITIES · 011</div>
          <h2 class="chapter-title serif">
            <span class="line"><span>Eleven <span class="it">disciplines</span>.</span></span>
            <span class="line"><span>Scroll sideways.</span></span>
          </h2>
        </div>
        <p>
          {/* Was "Each discipline takes the full screen — copy to the
              left, frame to the right." That is a stage direction: it
              described the page layout to the person already looking at
              it. Replaced with the thing a buyer actually wants to know
              about an eleven-discipline list. */}
          One founder-led studio in Edmonton for the brand, the website, and the work
          that brings customers in. Matt stays involved. For storefronts, KR8TIV designs
          and can manage the journey from concept through supplier sourcing, manufacturing
          coordination and installation liaison. Fabricators and builders do the physical work.
          <span class="services-floor-note">
            Figures are engagement floors, not menu prices: where a real project starts.
            Small one-off pieces sit below them; ask and we&rsquo;ll tell you honestly.
          </span>
        </p>
      </div>
    </div>
  </div>
  <div class="services-pin" id="svc-pin">
    <div class="services-track" id="svc-track">
      {SERVICES.map((s) => (
        <div class="svc-panel">
          <div class="svc-inner">
            <div class="svc-copy">
              <div class="meta"><span class="b"></span>{s.tag}</div>
              <h3>{s.t.split(' ').map((word, i, arr) => (
                i === arr.length - 1 ? <span class="ac">{word}</span> : <span>{word} </span>
              ))}</h3>
              <p>{s.desc}</p>
              <div class="price">ENGAGEMENTS FROM<span class="p">{s.price}</span></div>
              {s.href && <a class="svc-more" href={s.href}>Explore {s.t.toLowerCase()} <span aria-hidden="true">→</span></a>}
            </div>
            <a class={s.obj ? "svc-frame svc-frame--obj" : "svc-frame"} data-cursor="media" href={s.href} tabindex="-1" aria-hidden="true">
              <span class="svc-frame-bloom" aria-hidden="true"></span>
              {s.obj ? (
                /* 3D object loop: lazy-autoplays in view (lazyVideo.ts),
                   parks on its poster for prefers-reduced-motion. */
                <video class="svc-obj" muted loop playsinline preload="none" data-rm-poster
                  width="640" height="640" poster={disciplineLoop(s.obj).poster} aria-hidden="true">
                  <source media="(max-width: 720px)" src={disciplineLoop(s.obj).webmM} type="video/webm" />
                  <source media="(max-width: 720px)" src={disciplineLoop(s.obj).mp4M} type="video/mp4" />
                  <source src={disciplineLoop(s.obj).webm} type="video/webm" />
                  <source src={disciplineLoop(s.obj).mp4} type="video/mp4" />
                </video>
              ) : (
                <video muted loop playsinline preload="none" poster={videoPoster(s.v)}>
                  <source src={`/${vv(s.v)}`} type="video/mp4" />
                </video>
              )}
            </a>
          </div>
        </div>
      ))}
    </div>
    <div class="svc-rec">REC</div>
    <div class="svc-counter"><span class="n" id="svc-cnt">01</span>OF 011</div>
    <div class="svc-rail" aria-label="Discipline navigation">
      <div class="svc-rail-ticks" id="svc-rail-ticks">
        {SERVICES.map((s, idx) => (
          <button
            type="button"
            class:list={['svc-tick', { active: idx === 0 }]}
            data-svc-idx={idx}
            title={`${String(idx + 1).padStart(2, '0')} · ${s.t}`}
            aria-label={`Jump to ${s.t}`}
          >
            <span class="svc-tick-num">{String(idx + 1).padStart(2, '0')}</span>
            <span class="svc-tick-name">{s.em}</span>
          </button>
        ))}
      </div>
      <a class="svc-rail-all" href="/services/">All 11 as list ↗</a>
    </div>
  </div>
</section>

<script>
  import { isPhoneClassTouch } from '@lib/devicePolicy';

  const track = document.getElementById('svc-track');
  const pin = document.getElementById('svc-pin');
  const cnt = document.getElementById('svc-cnt');

  // Phones and touch tablets get the same forced horizontal scroll as
  // desktop: the section pins and vertical scrolling drives the track
  // sideways. Touch-specific settings below keep it smooth on iOS.
  const isTouch = isPhoneClassTouch() || window.matchMedia('(max-width: 720px)').matches;

  if (track && pin) {
    const panels = track.querySelectorAll('.svc-panel');
    // The TRUE track width is the layout width of all panels PLUS the
    // margin-right gaps between them. Using `panels × offsetWidth`
    // silently drops the 100px inter-panel gaps (`margin-right: 100px`
    // in core.css), so the pin released ~1100px early and the final
    // panel got cut off before reaching the viewport.
    //
    // `scrollWidth` on the flex track reflects the real rendered
    // width including all children + their margins, and auto-updates
    // on resize via invalidateOnRefresh. This is the number the pan
    // needs to travel to bring panel 12 flush with the left edge.
    Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([gsapMod, stMod]) => {
      const gsap = gsapMod.gsap;
      const ScrollTrigger = stMod.ScrollTrigger;
      gsap.registerPlugin(ScrollTrigger);
      if (isTouch) {
        // iOS Safari resizes the viewport as the address bar shows and
        // hides. Without this every resize re-measures the pin and the
        // page visibly jumps. Height changes alone are ignored; width
        // changes (rotation) still refresh.
        ScrollTrigger.config({ ignoreMobileResize: true });
      }
      // On phones the track's scrollWidth also counts a few px of paint
      // overflow (the last circle's bloom), so the pan ran ~6px long and
      // each panel drifted a little further left of centre (panel 11 sat
      // 6px off). Measuring to the last panel's own right edge makes the
      // travel exactly (panels - 1) x 100vw, so every circle lands on the
      // viewport's centre line. Desktop keeps the scrollWidth measure.
      const lastPanel = panels[panels.length - 1] as HTMLElement | undefined;
      const getSlideDistance = () => {
        if (isTouch && lastPanel) {
          return Math.max(0, lastPanel.offsetLeft + lastPanel.offsetWidth - window.innerWidth);
        }
        return Math.max(0, track.scrollWidth - window.innerWidth);
      };
      const ticks = Array.from(pin.querySelectorAll<HTMLButtonElement>('.svc-tick'));
      const st = ScrollTrigger.create({
        trigger: pin,
        start: 'top top',
        end: () => '+=' + getSlideDistance(),
        pin: true,
        anticipatePin: 1,
        scrub: isTouch ? 0.5 : 0.8,
        // Phones and touch tablets: when the finger lets go, settle on the
        // nearest discipline so its object, halo and platform rest on the
        // viewport's centre line instead of wherever the flick stopped.
        // Each panel is exactly 100vw there, so panel k sits dead centre
        // at progress k / (panels - 1). Desktop keeps free scrubbing.
        snap: isTouch && panels.length > 1 ? {
          snapTo: 1 / (panels.length - 1),
          duration: { min: 0.18, max: 0.5 },
          delay: 0.06,
          ease: 'power2.out',
          inertia: false
        } : undefined,
        onUpdate: (self) => {
          const slide = getSlideDistance();
          track.style.transform = `translateX(${-self.progress * slide}px)`;
          const p = Math.max(0, Math.min(1, self.progress));
          const idx = Math.min(panels.length - 1, Math.round(p * (panels.length - 1)));
          if (cnt) {
            cnt.textContent = String(idx + 1).padStart(2, '0');
          }
          ticks.forEach((btn, bIdx) => btn.classList.toggle('active', bIdx === idx));
        },
        invalidateOnRefresh: true
      });

      ticks.forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.svcIdx ?? '0');
          const ratio = panels.length > 1 ? idx / (panels.length - 1) : 0;
          const targetY = st.start + ratio * Math.max(0, st.end - st.start);
          const lenis = (window as unknown as { __KR8?: { lenis?: { scrollTo: (t: number, o?: unknown) => void } } }).__KR8?.lenis;
          if (lenis && typeof lenis.scrollTo === 'function') {
            lenis.scrollTo(targetY, { duration: 0.85 });
          } else {
            window.scrollTo({ top: targetY, behavior: 'smooth' });
          }
        });
      });
      // The pin adds a spacer that pushes every later trigger down;
      // re-measure so sections below start at the right scroll offset.
      ScrollTrigger.refresh();
    }).catch((err) => console.error('[KR8·services] GSAP import failed:', err));
  }

  // === Cursor-reactive prism on each service frame ===
  // Mirrors the hero's WebGL prism: every frame reads the pointer's
  // position within its own bounding box, writes --px / --py / --active
  // as CSS custom properties, which the ::before (spectrum band) and
  // ::after (caustic line) pseudo-elements consume to tilt + brighten.
  // Lerped for smoothness — matches the hero's 0.12 factor.
  document.querySelectorAll<HTMLElement>('.svc-frame').forEach((frame) => {
    const state = { tx: 0.5, ty: 0.5, ta: 0, cx: 0.5, cy: 0.5, ca: 0 };
    let raf = 0;
    const tick = () => {
      state.cx += (state.tx - state.cx) * 0.12;
      state.cy += (state.ty - state.cy) * 0.12;
      state.ca += (state.ta - state.ca) * 0.08;
      frame.style.setProperty('--px', state.cx.toFixed(3));
      frame.style.setProperty('--py', state.cy.toFixed(3));
      frame.style.setProperty('--active', state.ca.toFixed(3));
      if (Math.abs(state.tx - state.cx) > 0.001 ||
          Math.abs(state.ty - state.cy) > 0.001 ||
          Math.abs(state.ta - state.ca) > 0.001) {
        raf = requestAnimationFrame(tick);
      } else { raf = 0; }
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
    frame.addEventListener('pointermove', (e: PointerEvent) => {
      const r = frame.getBoundingClientRect();
      state.tx = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
      state.ty = Math.max(0, Math.min(1, (e.clientY - r.top) / r.height));
      state.ta = 1;
      kick();
    });
    frame.addEventListener('pointerleave', () => {
      state.ta = 0;
      state.tx = 0.5; state.ty = 0.5;
      kick();
    });
  });
</script>
