---
/**
 * Atmosphere plate — AVIF/WebP poster + optional looping MP4.
 * Never carries SEO text. Video pauses off-screen / reduced-motion /
 * site motion-off; poster remains the visible fallback.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
export interface Props {
  src: string; // path without extension or with .webp
  alt: string;
  video?: string; // /kr8tiv-assets/services/*.mp4
  variant?: 'hero' | 'support';
  width?: number;
  height?: number;
  priority?: boolean;
}
const {
  src,
  alt,
  video,
  variant = 'support',
  width = 1280,
  height = 720,
  priority = false,
} = Astro.props;
const webp = src.endsWith('.webp') ? src : `${src}.webp`;
const stem = webp.replace(/\.webp$/, '');
const avif = `${stem}.avif`;
// Build-time checks: only emit an AVIF source when the file exists (a
// missing AVIF would otherwise win the <picture> and show a broken image),
// and add a lighter phone-width encode when a "-mobile.mp4" sibling exists.
const inPublic = (url: string) => existsSync(join(process.cwd(), 'public', url.split('?')[0]));
const hasAvif = inPublic(avif);
const mobileVideo = video ? video.replace(/\.mp4(\?.*)?$/, '-mobile.mp4$1') : undefined;
const hasMobileVideo = !!(mobileVideo && mobileVideo !== video && inPublic(mobileVideo));
const imgClass = variant === 'hero' ? 'svp-hero-img' : 'svp-plate-img';
const vidClass = variant === 'hero' ? 'svp-hero-vid' : 'svp-plate-vid';
---
<div
  class:list={[
    'svp-plate-stage',
    `svp-plate-stage--${variant}`,
    video && 'svp-plate-stage--has-video',
  ]}
  data-svp-plate
>
  <picture>
    {hasAvif && <source type="image/avif" srcset={avif} width={width} height={height} />}
    <img
      class={imgClass}
      src={webp}
      alt={alt}
      width={width}
      height={height}
      decoding="async"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </picture>
  {video && (
    <video
      class={vidClass}
      autoplay
      muted
      loop
      playsinline
      preload={priority ? 'metadata' : 'none'}
      poster={webp}
      aria-hidden="true"
      data-svp-plate-video
    >
      {hasMobileVideo && <source src={mobileVideo} type="video/mp4" media="(max-width: 900px)" />}
      <source src={video} type="video/mp4" />
    </video>
  )}
  <span class="svp-plate-glow" aria-hidden="true"></span>
  <span class="svp-plate-veil" aria-hidden="true"></span>
</div>
