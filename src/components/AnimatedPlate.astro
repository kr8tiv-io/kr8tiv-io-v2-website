---
/**
 * Atmosphere plate — AVIF/WebP poster + optional looping MP4.
 * Never carries SEO text. Video pauses off-screen / reduced-motion /
 * site motion-off; poster remains the visible fallback.
 */
export interface Props {
  src: string; // path without extension or with .webp
  alt: string;
  video?: string; // /kr8tiv-assets/services/*.mp4
  variant?: 'hero' | 'support';
  width?: number;
  height?: number;
  priority?: boolean;
}
const {
  src,
  alt,
  video,
  variant = 'support',
  width = 1280,
  height = 720,
  priority = false,
} = Astro.props;
const webp = src.endsWith('.webp') ? src : `${src}.webp`;
const stem = webp.replace(/\.webp$/, '');
const avif = `${stem}.avif`;
const imgClass = variant === 'hero' ? 'svp-hero-img' : 'svp-plate-img';
const vidClass = variant === 'hero' ? 'svp-hero-vid' : 'svp-plate-vid';
---
<div
  class:list={[
    'svp-plate-stage',
    `svp-plate-stage--${variant}`,
    video && 'svp-plate-stage--has-video',
  ]}
  data-svp-plate
>
  <picture>
    <source type="image/avif" srcset={avif} width={width} height={height} />
    <img
      class={imgClass}
      src={webp}
      alt={alt}
      width={width}
      height={height}
      decoding="async"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </picture>
  {video && (
    <video
      class={vidClass}
      autoplay
      muted
      loop
      playsinline
      preload={priority ? 'metadata' : 'none'}
      poster={webp}
      aria-hidden="true"
      data-svp-plate-video
    >
      <source src={video} type="video/mp4" />
    </video>
  )}
  <span class="svp-plate-glow" aria-hidden="true"></span>
  <span class="svp-plate-veil" aria-hidden="true"></span>
</div>
