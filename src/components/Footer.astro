---
/**
 * Footer.astro — sitewide footer.
 *
 * Pulled out of Contact.astro so the same .foot-grid / .foot-bar lands
 * on every page — previously only the homepage Contact section
 * carried it, so /process/, /work/, /terms/, /start/, /build-notes/
 * all dead-ended without the column nav + privacy link the user
 * loves. Now imported once in BaseLayout, no per-page wiring needed.
 *
 * Identical markup + styling to the original Contact.astro footer
 * block — the user explicitly said "the footer is beautiful, I just
 * want it on all our pages", so the design contract here is "don't
 * touch the look, just lift the location."
 *
 * The only structural change vs the inlined version: the Navigate
 * column now points at canonical pages (/work/, /process/, /start/)
 * instead of in-page anchors, so the footer works regardless of which
 * page the user is on, and a Privacy + Terms link drops into the
 * Reach column to satisfy the legal-doc discoverability requirement.
 */
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-col">
        <h3>Navigate</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/work/">Work</a></li>
          <li><a href="/about/">About Matt</a></li>
          <li><a href="/process/">Process</a></li>
          <li><a href="/start/">Start a project</a></li>
          <li><a href="/blog/">Field notes</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Services</h3>
        <ul>
          <li><a href="/services/web-design-edmonton/">Web design Edmonton</a></li>
          <li><a href="/services/branding/">Branding + identity</a></li>
          <li><a href="/services/print-signage-design/">Storefront + sign design</a></li>
          <li><a href="/services/packaging-design-edmonton/">Packaging design</a></li>
          <li><a href="/services/video-editing-edmonton/">Video editing</a></li>
          <li><a href="/services/ecommerce-website-edmonton/">Ecommerce setups</a></li>
          <li><a href="/services/motion-3d-edmonton/">Motion + 3D</a></li>
          <li><a href="/services/">All eleven services</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Reach</h3>
        <ul>
          <li><a href="tel:+17809155471">(780) 915-5471</a></li>
          <li><a href="mailto:kr8tiv@kr8tiv.io">kr8tiv@kr8tiv.io</a></li>
          <li><a href="https://calendly.com/kr8tiv" target="_blank" rel="noopener noreferrer">Book a call</a></li>
          <li><a href="https://www.linkedin.com/company/kr8tiv-agency" target="_blank" rel="noopener noreferrer">LinkedIn (studio)</a></li>
          <li><a href="https://www.linkedin.com/in/matthaynes88/" target="_blank" rel="noopener noreferrer">LinkedIn (Matt)</a></li>
          <li><a href="https://g.page/r/Cf3IkEeasCMiEBM" target="_blank" rel="noopener noreferrer">Find us on Google</a></li>
          <li><a href="https://g.page/r/Cf3IkEeasCMiEBM/review" target="_blank" rel="noopener noreferrer">Leave us a Google review</a></li>
          <li><a href="/terms/">Privacy + Terms</a></li>
          <li><a href="/llms.txt">Plain-text pages</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Capabilities</h3>
        <ul>
          <li>Brand + Identity</li>
          <li>Website Design</li>
          <li>Motion + 3D</li>
          <li>AI Automation</li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Location + hours</h3>
        <ul>
          <li>Edmonton, Alberta</li>
          <li>Sherwood Park · St. Albert · Spruce Grove</li>
          <li>Serving clients across Canada</li>
          <li><strong>Hours:</strong> Mon to Sat, 9:00 AM to 6:00 PM Mountain Time</li>
          <li>Sunday closed</li>
          <li class="studio-live-row" data-studio-clock hidden>
            <span class="studio-live-dot" aria-hidden="true"></span>
            <span data-studio-clock-text>Edmonton · Mountain Time</span>
          </li>
        </ul>
      </div>
    </div>
    <div class="foot-bar">
      <div>© 2026 KR8TIV · PRISM EDITION</div>
      <div>
        侍 DESIGN SAMURAI
        <button class="white-light-btn" id="white-light-btn" type="button" aria-label="Return to white light">
          ↳ Return to white light
        </button>
      </div>
      <div>INDEX / 008</div>
    </div>
  </div>
</footer>

<style>
  .studio-live-row {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--edge);
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .studio-live-row[hidden] {
    display: none;
  }
  .studio-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-4);
    box-shadow: 0 0 8px var(--accent-4);
  }
  .studio-live-row[data-open="true"] .studio-live-dot {
    background: #3dffb5;
    box-shadow: 0 0 8px rgba(61, 255, 181, .8);
  }
</style>

<script>
  const row = document.querySelector<HTMLElement>('[data-studio-clock]');
  const txt = document.querySelector<HTMLElement>('[data-studio-clock-text]');
  if (row && txt && typeof Intl !== 'undefined') {
    const updateClock = () => {
      try {
        const now = new Date();
        const parts = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Edmonton',
          weekday: 'short',
          hour: 'numeric',
          minute: '2-digit',
          hour12: false
        }).formatToParts(now);
        const wk = parts.find((p) => p.type === 'weekday')?.value ?? '';
        const hr = Number(parts.find((p) => p.type === 'hour')?.value ?? '0');
        const disp = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Edmonton',
          hour: 'numeric',
          minute: '2-digit',
          hour12: true
        }).format(now);
        const isOpen = !wk.toLowerCase().startsWith('sun') && hr >= 9 && hr < 18;
        row.dataset.open = isOpen ? 'true' : 'false';
        txt.textContent = `${disp} MT · ${isOpen ? 'STUDIO OPEN' : 'REPLIES AT 9 AM'}`;
        row.hidden = false;
      } catch {
        row.hidden = true;
      }
    };
    updateClock();
    window.setInterval(updateClock, 60000);
  }
</script>
