---
import FormLayout from '@layouts/FormLayout.astro';
import PortfolioGrid from '@components/PortfolioGrid.astro';
---
<FormLayout title="Selected Websites & Brand Design | KR8TIV" description="Selected websites, brand identities and business-card design from KR8TIV in Edmonton. Client work, studio ventures and staging projects, clearly labelled." canonical="/work/" pageType="CollectionPage" currentNav="work">
<section class="gallery-page" id="main">
<header class="gallery-head"><p class="gallery-eye">KR8TIV · SELECTED WORK</p><h1>Good work.<br/><em>Worth a closer look.</em></h1><p>Websites and identity systems with their own point of view. Browse the live projects, explore the staging work, or look closer at the print design.</p></header>
<PortfolioGrid />
<footer class="gallery-footer"><h2>Have something in mind?</h2><p>Tell Matt what you are building and where it needs to go.</p><a href="/start/">Start a project →</a></footer>
</section>
</FormLayout>
<style>
.gallery-page{max-width:1280px;margin:auto;padding:150px 32px 100px}.gallery-head{max-width:800px;margin-bottom:72px}.gallery-eye{font:11px/1.5 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--accent-4)}.gallery-head h1{font:clamp(56px,7vw,104px)/.98 'Instrument Serif',serif;letter-spacing:-.025em;margin:24px 0 32px}.gallery-head h1 em{font-weight:400;color:var(--accent-1)}.gallery-head>p:last-child{max-width:58ch;font:18px/1.7 'Inter Tight',sans-serif;color:var(--ink-muted)}.gallery-footer{margin:80px 0 0;text-align:center;padding:48px 16px;border-top:1px solid var(--edge)}.gallery-footer h2{font:52px/1.1 'Instrument Serif',serif}.gallery-footer p{margin:20px 0}.gallery-footer a{color:var(--accent-4);text-decoration:underline}@media(max-width:720px){.gallery-page{padding:110px 18px 70px}.gallery-head{margin-bottom:40px}.gallery-head h1{font-size:58px}}
</style>
