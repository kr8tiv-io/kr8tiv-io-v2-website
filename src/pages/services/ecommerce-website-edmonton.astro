import FormLayout from '@layouts/FormLayout.astro';
import ServicePage from '@components/ServicePage.astro';
const faqs = [{"q": "How much does an ecommerce website cost?", "a": "KR8TIV ecommerce store setup starts from $1,500 CAD. Platform subscriptions, apps and payment fees are paid directly to those providers. Final scope is agreed in writing first. No GST charged."}, {"q": "Which platform do you use?", "a": "The platform is chosen to fit your products and team. Stores can be built on Shopify, Webflow, Astro or a custom stack."}, {"q": "Can you set up a dropshipping store?", "a": "Yes. Ecommerce setups range from dropship stores to full brands. Supplier agreements and product claims remain your responsibility."}, {"q": "Who owns the store after launch?", "a": "You do. Accounts, ownership and handoff are agreed before work starts, and clients own their final files."}, {"q": "How does a project start?", "a": "Every project starts with a free 30-minute call with Matt. Scope, deliverables and price are agreed in writing, then payment is split 40% at kickoff, 40% at draft delivery and 20% at final delivery. No GST charged."}];
---
