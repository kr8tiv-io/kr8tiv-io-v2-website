    hero={{"src": "/kr8tiv-assets/services/ecommerce-website-edmonton-hero.webp", "video": "/kr8tiv-assets/services/ecommerce-website-edmonton-hero.mp4", "alt": "Wireframe hills with drifting particle trees under a beam of light"}}
    sections={[{"num": "01 · What you get", "title": "A store that makes buying <em>obvious</em>.", "body": ["A good store answers the buyer’s questions before they ask: what it is, what it costs, when it arrives and how to get help. We design the store around those answers and the products you actually sell.", "The platform is chosen to fit the business. Stores can be plugged into Shopify, Webflow, Astro or a custom build, with ownership of accounts and handoff agreed before the build."], "cards": [{"k": "From $1,500 CAD", "t": "Store setup", "d": "Store design and setup with an agreed number of templates, products and pages."}, {"k": "Included in scope", "t": "Product pages", "d": "Clear product pages with readable details, images and calls to action."}, {"k": "$75 / month", "t": "Website Care", "d": "Optional ongoing care after launch."}]}, {"num": "02 · How it runs", "title": "From product list to <em>first order</em>.", "steps": [{"t": "Call", "d": "A free 30-minute call about your products, customers and platform."}, {"t": "Collect", "d": "Product data, photos, brand files, shipping and policy details."}, {"t": "Design", "d": "Store and product page design, reviewed in structured rounds."}, {"t": "Build and connect", "d": "Set up on the agreed platform, with payments and shipping settings confirmed with you."}, {"t": "Launch", "d": "Test orders, handoff and training. You own the store and its content."}]}, {"num": "03 · Who does what", "title": "You run the business. <em>We build the shop.</em>", "body": ["KR8TIV designs and sets up the store. Platform fees, apps, payment processing and ad spend are paid directly by you to those providers. Product information, pricing and policies come from you.", "Selling online works better with a strong brand and good product imagery, so a store can share a direction with your <a href=\"/services/branding/\">identity</a>, <a href=\"/services/packaging-design-edmonton/\">packaging</a> and <a href=\"/services/ads-acquisition-edmonton/\">ads</a>. See <a href=\"/services/web-design-edmonton/\">web design</a> if you need a site without a store."]}]}
    faqs={faqs}
