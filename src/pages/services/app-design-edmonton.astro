const faqs = [{"q": "How much does app design cost?", "a": "Ground-up app product design with KR8TIV starts from $3,500 CAD. Focused UX/UI work starts from $1,500 CAD. Final scope is agreed in writing first. No GST charged."}, {"q": "Do you develop the app as well?", "a": "The service is product design: IA, UX, UI, prototypes and handoff. Development is done by your developers or a build partner agreed in the scope."}, {"q": "Native or web app?", "a": "Both. The design approach is chosen around your users and the platforms you plan to launch on."}, {"q": "Will I own the designs?", "a": "Yes. Clients own their final files."}, {"q": "How does a project start?", "a": "Every project starts with a free 30-minute call with Matt. Scope, deliverables and price are agreed in writing, then payment is split 40% at kickoff, 40% at draft delivery and 20% at final delivery. No GST charged."}];
