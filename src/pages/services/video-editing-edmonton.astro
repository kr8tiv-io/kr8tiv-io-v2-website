---
/** /services/video-editing-edmonton/ : generated from the shared ServicePage pattern.
 *  Price floor mirrors FLOOR in src/lib/content.ts. No em dashes in copy. */
import FormLayout from '@layouts/FormLayout.astro';
import ServicePage from '@components/ServicePage.astro';
const faqs = [{"q": "How much does video editing cost in Edmonton?", "a": "KR8TIV video editing starts from $400 CAD for a promo or feature edit. Motion graphics and 3D start from $750 CAD. Final scope, formats and revision rounds are agreed in writing before work starts. No GST charged."}, {"q": "Do you film as well as edit?", "a": "The core service is editing, motion and 3D animation. If the project needs filming, that is agreed in the scope and quoted separately."}, {"q": "Can you make vertical videos for social media?", "a": "Yes. Cut-downs for vertical and square formats can be scoped alongside the main edit."}, {"q": "Who owns the finished video?", "a": "You do. Clients own their final files. Licensed elements such as stock footage or music follow their own licence terms, which we confirm before use."}, {"q": "How does a project start?", "a": "Every project starts with a free 30-minute call with Matt. Scope, deliverables and price are agreed in writing, then payment is split 40% at kickoff, 40% at draft delivery and 20% at final delivery. No GST charged."}];
---
<FormLayout
  title="Video Editing in Edmonton | KR8TIV"
  description="Founder-led video editing in Edmonton: promo videos, feature edits, social cuts and 3D animation for Alberta businesses. Projects from $400 CAD."
  canonical="/services/video-editing-edmonton/"
  ogImage="/kr8tiv-assets/services/video-editing-edmonton-og.jpg"
  service={{"name": "Video editing in Edmonton", "serviceType": "Video editing and production", "description": "Founder-led video editing in Edmonton: promo videos, feature edits, social cuts and 3D animation for Alberta businesses. Projects from $400 CAD.", "priceFrom": 400, "priceCurrency": "CAD"}}
  breadcrumbs={[{"name": "Home", "url": "/"}, {"name": "Services", "url": "/services/"}, {"name": "Video editing", "url": "/services/video-editing-edmonton/"}]}
  faqs={faqs}
  keywords={["video editing Edmonton", "promo video Edmonton", "video production Alberta", "social video editing Canada", "3D animation Edmonton"]}
>
  <ServicePage
    eyebrow="Edmonton · Video editing"
    h1="Video editing in Edmonton. <em>Made to be watched.</em>"
    intro="KR8TIV is an Edmonton creative studio that edits promotional videos, feature pieces, social cuts and 3D animation for businesses across Alberta and Canada. Video editing starts from $400 CAD, and you work directly with Matt Haynes, the founder, from first cut to final file."
    price="Promo and feature videos from $400 CAD · Motion and 3D from $750 CAD · No GST charged"
    cta={{"label": "Send Matt your footage plan", "href": "/start/"}}
    hero={{"src": "/kr8tiv-assets/services/video-editing-edmonton-hero.webp", "video": "/kr8tiv-assets/services/video-editing-edmonton-hero.mp4", "alt": "White wireframe peaks rising from a dark digital landscape"}}
    sections={[{"num": "01 · What you get", "title": "Edits with a <em>job to do</em>.", "body": ["A video has to earn the next second of attention. We cut for the place it will actually play: a website hero, a social feed, a pitch, a product page or a screen in your store.", "Bring your footage, your brand files and the one thing a viewer should do after watching. If footage, music or voiceover is missing, we flag it early and agree who supplies it."], "cards": [{"k": "From $400 CAD", "t": "Promo or feature edit", "d": "A focused edit for one message, with agreed length, formats and revision rounds."}, {"k": "Quoted to scope", "t": "Social cut-downs", "d": "Vertical and square versions of a main edit, sized for the platforms you use."}, {"k": "From $750 CAD", "t": "Motion + 3D", "d": "Animated titles, logo moments and 3D sequences that sit inside the edit."}]}, {"num": "02 · How it runs", "title": "From raw footage to <em>final file</em>.", "steps": [{"t": "Call", "d": "A free 30-minute call to agree the goal, the audience and where the video will live."}, {"t": "Collect", "d": "You share footage, brand files, references and any approved claims or captions."}, {"t": "First cut", "d": "A rough edit shows structure and pacing before details are polished."}, {"t": "Refine", "d": "Structured feedback rounds tune timing, titles, colour and sound."}, {"t": "Deliver", "d": "Final files in the agreed formats. You own the finished video."}]}, {"num": "03 · Who does what", "title": "The person you brief <em>edits the video</em>.", "body": ["There is no account layer. Matt is on the call, on the brief and on the review. KR8TIV edits and animates; filming, talent, locations and licensed music are agreed in the scope and quoted separately when needed.", "Video often works best alongside the rest of your brand, so it can share a direction with your <a href=\"/services/branding/\">identity</a>, your <a href=\"/services/web-design-edmonton/\">website</a> or a <a href=\"/services/ads-acquisition-edmonton/\">paid campaign</a>."]}]}
    faqs={faqs}
    finalTitle="One clear message. <em>Edited to land.</em>"
    related={[{"label": "Motion + 3D", "href": "/services/motion-3d-edmonton/"}, {"label": "Ads + acquisition", "href": "/services/ads-acquisition-edmonton/"}, {"label": "Studio + A/V", "href": "/services/studio-av-production-edmonton/"}, {"label": "All services", "href": "/services/"}]}
  />
</FormLayout>
