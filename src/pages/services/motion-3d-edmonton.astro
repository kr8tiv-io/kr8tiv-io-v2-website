const faqs = [{"q": "How much does motion graphics or 3D animation cost?", "a": "KR8TIV motion and 3D work starts from $750 CAD. Longer or more complex sequences are quoted to scope in writing before work starts. No GST charged."}, {"q": "Can you animate our existing logo?", "a": "Yes. Logo animations can be built from your existing brand files."}, {"q": "Will animation slow down our website?", "a": "Web motion is designed to stay light. Loops are compressed, phones get lighter versions, and heavy 3D effects can be switched off on mobile."}, {"q": "What formats do you deliver?", "a": "Formats and sizes are agreed in the scope, for example website loops, social posts or presentation screens."}, {"q": "How does a project start?", "a": "Every project starts with a free 30-minute call with Matt. Scope, deliverables and price are agreed in writing, then payment is split 40% at kickoff, 40% at draft delivery and 20% at final delivery. No GST charged."}];
---
<FormLayout
