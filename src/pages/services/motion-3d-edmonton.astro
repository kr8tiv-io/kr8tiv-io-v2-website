  service={{"name": "Motion graphics and 3D in Edmonton", "serviceType": "Motion graphics and 3D animation", "description": "Motion graphics, 3D animation and cinematic sequences from an Edmonton studio for brands across Alberta and Canada. Projects from $750 CAD.", "priceFrom": 750, "priceCurrency": "CAD"}}
  breadcrumbs={[{"name": "Home", "url": "/"}, {"name": "Services", "url": "/services/"}, {"name": "Motion + 3D", "url": "/services/motion-3d-edmonton/"}]}
  faqs={faqs}
  keywords={["motion graphics Edmonton", "3D animation Edmonton", "logo animation Alberta", "3D product animation Canada"]}
>
