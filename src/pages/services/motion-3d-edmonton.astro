    cta={{"label": "Describe the moment to Matt", "href": "/start/"}}
    hero={{"src": "/kr8tiv-assets/services/motion-3d-edmonton-hero.webp", "video": "/kr8tiv-assets/services/motion-3d-edmonton-hero.mp4", "alt": "A tall obelisk spike rising from glowing wireframe hills"}}
    sections={[{"num": "01 · What you get", "title": "Movement that <em>means something</em>.", "body": ["Motion should explain, reveal or set a mood, not just spin. We design logo moments, animated titles, product reveals, looping website backgrounds and 3D sequences around one clear idea.", "The landscapes moving across this site are examples of the kind of atmosphere we build for brands that want to feel cinematic."], "cards": [{"k": "From $750 CAD", "t": "Motion graphics", "d": "Animated logos, titles and explainer moments with agreed length and formats."}, {"k": "Quoted to scope", "t": "3D sequences", "d": "3D scenes, product reveals and cinematic loops."}, {"k": "Quoted to scope", "t": "Web motion", "d": "Lightweight loops and scroll moments designed to load fast on phones."}]}, {"num": "02 · How it runs", "title": "From storyboard to <em>render</em>.", "steps": [{"t": "Call", "d": "A free 30-minute call about the idea, the audience and where it will play."}, {"t": "Collect", "d": "Brand files, references, product models or photos, and copy."}, {"t": "Three directions", "d": "Three distinct looks or storyboards instead of one."}, {"t": "Animate", "d": "Animation in structured rounds, from blocking to final render."}, {"t": "Deliver", "d": "Final renders in the agreed formats and sizes. You own the final files."}]}, {"num": "03 · Who does what", "title": "One studio, <em>one direction</em>.", "body": ["Matt leads the concept and the review. Motion pieces can sit inside a <a href=\"/services/video-editing-edmonton/\">video edit</a>, on your <a href=\"/services/web-design-edmonton/\">website</a> or in a <a href=\"/services/print-signage-design/\">3D store concept</a>, so the whole brand moves the same way."]}]}
    faqs={faqs}
    finalTitle="Make the brand <em>move</em>."
