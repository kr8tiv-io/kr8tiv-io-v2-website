---
/**
 * /services/ — hub for the eleven disciplines.
 * Before this page existed, /services/ returned 403 (bare directory) even
 * though every service page's breadcrumb implies a Services level.
 * Copy and engagement floors mirror the homepage services section; keep
 * them in sync (and in sync with hasOfferCatalog in Seo.astro).
 * Deliberately does NOT import Services.astro (the homepage scroller is
 * being reworked on its own branch).
 */
import FormLayout from '@layouts/FormLayout.astro';
import '@styles/services.css';

const disciplines = [
  { n: '001', t: 'Website Design', d: 'Websites that look sharp, explain your offer, and make it clear how to call. Built in Edmonton for businesses across Alberta and Canada.', from: '$1,950+', href: '/services/web-design-edmonton/' },
  { n: '002', t: 'Branding + Identity', d: 'Your logo, your voice, and a visual system for your website, storefront, packaging, and business cards.', from: '$500+', href: '/services/branding/' },
  { n: '003', t: 'Video Editing', d: 'Video editing, promotional features and 3D animation. Video that stops the scroll and actually gets watched.', from: '$400+', href: '/services/video-editing-edmonton/' },
  { n: '004', t: 'Ecommerce Setups', d: 'A customized ecom stack to help you sell anything online, from dropship stores to full brands.', from: '$1,500+', href: '/services/ecommerce-website-edmonton/' },
  { n: '005', t: 'UX/UI + Blockchain', d: 'Product UX, interface systems and design tokens for web apps, mobile apps, and on-chain products.', from: '$1,500+', href: '/services/ux-ui-design-edmonton/' },
  { n: '006', t: 'Signage + Print', d: 'Storefronts, signs and immersive store experiences. Start with a concept, or have KR8TIV manage supplier sourcing, production coordination and installation liaison.', from: '~$500', href: '/services/print-signage-design/' },
  { n: '007', t: 'Packaging + Mockups', d: 'Packaging design and mockups. Unboxing is a ritual, not a logistics problem.', from: '$800+', href: '/services/packaging-design-edmonton/' },
  { n: '008', t: 'Studio + A/V Print', d: 'Full studio production: web, audio/video and print, all under one roof.', from: '$1,500+', href: '/services/studio-av-production-edmonton/' },
  { n: '009', t: 'Ads + Acquisition', d: 'Paid social, display, video and creator campaigns. Creative built for performance, written for humans.', from: '$900+', href: '/services/ads-acquisition-edmonton/' },
  { n: '010', t: 'App Product Design', d: 'Native and web app product design: IA, UX, UI, prototypes and handoff.', from: '$3,500+', href: '/services/app-design-edmonton/' },
  { n: '011', t: 'Motion + 3D', d: '3D, motion graphics and cinematic sequences, delivered with intent.', from: '$750+', href: '/services/motion-3d-edmonton/' }
];
const floors = [
  { offer: 'Landing page', floor: 'from $850 CAD', href: '/services/web-design-edmonton/' },
  { offer: 'Landing page + search setup', floor: '$1,250 CAD', href: '/services/web-design-edmonton/' },
  ...disciplines.flatMap((s) => [
    { offer: s.t, floor: `${s.from} CAD`, href: s.href },
    ...(s.href === '/services/branding/' ? [
      { offer: 'Brand Kit', floor: '$1,050 CAD', href: '/services/branding/' },
      { offer: 'Full Rebrand', floor: 'from $2,450 CAD', href: '/services/branding/' }
    ] : [])
  ]),
  { offer: 'Website Care', floor: '$75 / month', href: '/services/ecommerce-website-edmonton/' },
  { offer: 'Reviews Care', floor: '$295 / month', href: '/services/ads-acquisition-edmonton/' },
  { offer: 'Search Engine plan', floor: '$495 / month', href: '/services/ads-acquisition-edmonton/' },
  { offer: 'Search Dominance', floor: '$895 / month', href: '/services/ads-acquisition-edmonton/' },
  { offer: 'Social plans', floor: 'from $500 / month', href: '/services/ads-acquisition-edmonton/' },
  { offer: 'Fractional CMO', floor: '$1,950 / month', href: '/services/ads-acquisition-edmonton/' }
];
const faqs = [
  { q: 'What services does KR8TIV offer?', a: 'KR8TIV is a founder-led creative studio in Edmonton, Alberta offering eleven disciplines: website design, branding and identity, video editing, ecommerce setups, UX/UI and blockchain product design, signage and print, packaging, studio and A/V production, ads and acquisition creative, app product design, and motion and 3D.' },
  { q: 'How much do KR8TIV services cost?', a: 'Prices on this page are engagement floors in Canadian dollars, not menu prices. Full websites start from $1,950 CAD, branding from $500 CAD and app product design from $3,500 CAD. Final scope is agreed in writing before work begins. No GST charged.' },
  { q: 'Where does KR8TIV work?', a: 'KR8TIV is based in Edmonton and serves Edmonton, Sherwood Park, St. Albert and Spruce Grove, with clients across Alberta and Canada and remote projects further afield. Meetings are by call or by appointment.' }
];
---
<FormLayout
  title="Design, Web & Video Services in Edmonton | KR8TIV"
  description="Eleven disciplines from one founder-led Edmonton studio: websites, branding, video, ecommerce, signage, packaging, ads, apps, motion and 3D. Prices in CAD."
  canonical="/services/"
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }]}
  faqs={faqs}
>
  <main class="svp" id="main">
    <header class="svp-hero">
      <div class="svp-hero-copy">
        <div class="svp-eyebrow">Edmonton · Services</div>
        <h1>Eleven disciplines. <em>One founder-led studio.</em></h1>
        <p class="svp-intro">KR8TIV is a creative studio in Edmonton, Alberta. Matt Haynes and the studio design websites, brands, video, signage, packaging and campaigns for businesses across Alberta and Canada. Figures below are engagement floors in CAD, where a real project starts, with scope agreed in writing first.</p>
        <a class="svp-cta" href="/start/">Start a project <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <section class="svp-sec" aria-labelledby="disciplines">
      <h2 id="disciplines" class="svp-num">The eleven disciplines</h2>
      <div class="svp-cards">
        {disciplines.map((s) => (
          <div class="svp-card">
            <span class="k">/ {s.n} · From {s.from} CAD</span>
            <h3>{s.href ? <a href={s.href}>{s.t}</a> : s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="svp-sec" aria-labelledby="floors">
      <h2 id="floors">Floors, <em>not a menu</em>.</h2>
      <p>Canadian dollars. Starting points only. Scope is agreed in writing before work starts. No GST charged. Ad spend, fabrication and printing are quoted outside these floors.</p>
      <div class="svp-table-wrap">
        <table class="svp-floors">
          <caption>KR8TIV engagement floors in CAD</caption>
          <thead>
            <tr><th scope="col">Offer</th><th scope="col">Starts</th><th scope="col">Page</th></tr>
          </thead>
          <tbody>
            {floors.map((row) => (
              <tr>
                <th scope="row">{row.offer}</th>
                <td>{row.floor}</td>
                <td><a href={row.href}>Open</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="svp-sec svp-faq" id="faq">
      <div class="svp-sec-grid">
        <div><div class="svp-num">Questions</div><h2>Straight <em>answers</em>.</h2></div>
        <div>{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </div>
    </section>

    <section class="svp-final">
      <div class="svp-num">Edmonton · Alberta · Canada</div>
      <h2>Not sure which one you need? <em>Ask Matt.</em></h2>
      <a class="svp-cta" href="/start/">Start a project <span aria-hidden="true">→</span></a>
      <nav class="svp-related" aria-label="Related">
        <a href="/work/">Work</a><a href="/process/">Process</a><a href="/blog/">Field notes</a>
      </nav>
    </section>
  </main>
</FormLayout>
