---
/** /services/studio-av-production-edmonton/ : generated from the shared ServicePage pattern.
 *  Price floor mirrors FLOOR in src/lib/content.ts. No em dashes in copy. */
import FormLayout from '@layouts/FormLayout.astro';
import ServicePage from '@components/ServicePage.astro';
const faqs = [{"q": "How much does studio production cost?", "a": "KR8TIV studio + A/V print projects start from $1,500 CAD. Printing, fabrication and filming are quoted separately where needed. Final scope is agreed in writing first. No GST charged."}, {"q": "Can I book only one part, like video?", "a": "Yes. Web, video and print can each be booked as their own service."}, {"q": "Do you print in-house?", "a": "No. KR8TIV prepares print-ready artwork and can coordinate printers as scoped. Printing is quoted by the printer."}, {"q": "Who owns the finished work?", "a": "You do. Clients own their final files."}, {"q": "How does a project start?", "a": "Every project starts with a free 30-minute call with Matt. Scope, deliverables and price are agreed in writing, then payment is split 40% at kickoff, 40% at draft delivery and 20% at final delivery. No GST charged."}];
---
<FormLayout
  title="Studio, A/V & Print Production in Edmonton | KR8TIV"
  description="Full studio production in Edmonton: web, audio/video and print under one founder-led roof, for Alberta and Canadian brands. Projects from $1,500 CAD."
  canonical="/services/studio-av-production-edmonton/"
  ogImage="/kr8tiv-assets/services/studio-av-production-edmonton-og.jpg"
  service={{"name": "Studio, A/V and print production in Edmonton", "serviceType": "Web, audio/video and print studio production", "description": "Full studio production in Edmonton: web, audio/video and print under one founder-led roof, for Alberta and Canadian brands. Projects from $1,500 CAD.", "priceFrom": 1500, "priceCurrency": "CAD"}}
  breadcrumbs={[{"name": "Home", "url": "/"}, {"name": "Services", "url": "/services/"}, {"name": "Studio + A/V print", "url": "/services/studio-av-production-edmonton/"}]}
  faqs={faqs}
  keywords={["creative studio Edmonton", "video and print production Alberta", "web and print design Edmonton", "brand launch production Canada"]}
>
  <ServicePage
    eyebrow="Edmonton · Studio + A/V print"
    h1="Studio production in Edmonton. <em>Web, A/V and print, one roof.</em>"
    intro="KR8TIV is an Edmonton studio that produces web, audio/video and print work together, for businesses across Alberta and Canada that want one direction instead of three vendors. Studio + A/V print projects start from $1,500 CAD, led directly by founder Matt Haynes."
    price="Studio + A/V print from $1,500 CAD · Scope agreed in writing · No GST charged"
    cta={{"label": "Tell Matt what you are launching", "href": "/start/"}}
    hero={{"src": "/kr8tiv-assets/services/studio-av-production-edmonton-hero.webp", "video": "/kr8tiv-assets/services/studio-av-production-edmonton-hero.mp4", "alt": "Moonlit wireframe landscape with a single bright peak"}}
    sections={[{"num": "01 · What you get", "title": "One studio for the <em>whole launch</em>.", "body": ["A launch usually needs a website, a video and something printed, and each vendor tends to pull in a different direction. Studio production keeps them in one plan, one look and one conversation with Matt.", "We ship ready-to-use craft, not a handoff PDF that needs three more vendors."], "cards": [{"k": "Web", "t": "Site or landing page", "d": "A page that carries the launch, built to load fast and explain the offer."}, {"k": "A/V", "t": "Video and sound", "d": "Edits, motion and audio that match the brand."}, {"k": "Print", "t": "Print collateral", "d": "Cards, menus, posters and signage artwork, ready for your printer."}]}, {"num": "02 · How it runs", "title": "From brief to <em>launch day</em>.", "steps": [{"t": "Call", "d": "A free 30-minute call about the launch, the audience and the date."}, {"t": "Collect", "d": "Brand files, footage, copy and printer or venue specs."}, {"t": "Three directions", "d": "Three distinct concepts for the whole launch."}, {"t": "Produce", "d": "Web, video and print built together in structured rounds."}, {"t": "Deliver", "d": "Live site, final video files and print-ready artwork. You own the final files."}]}, {"num": "03 · Who does what", "title": "We produce the work. <em>Specialists print and install.</em>", "body": ["KR8TIV designs and produces the web, video and print artwork. Printing, fabrication and filming crews are agreed in the scope and quoted separately when needed. Each part can also be booked on its own: <a href=\"/services/web-design-edmonton/\">web design</a>, <a href=\"/services/video-editing-edmonton/\">video editing</a> and <a href=\"/services/print-signage-design/\">print and signage</a>."]}]}
    faqs={faqs}
    finalTitle="One direction <em>across every format</em>."
    related={[{"label": "Web design Edmonton", "href": "/services/web-design-edmonton/"}, {"label": "Video editing", "href": "/services/video-editing-edmonton/"}, {"label": "Storefront + sign design", "href": "/services/print-signage-design/"}, {"label": "All services", "href": "/services/"}]}
  />
</FormLayout>
