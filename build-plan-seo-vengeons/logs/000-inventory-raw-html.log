e=\"DC.language\" content=\"en\"><!-- ============ JSON-LD structured data ============ --><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://kr8tiv.io/#organization\",\"name\":\"KR8TIV\",\"alternateName\":[\"KR8TIV Atelier\",\"Kr8tiv\",\"KR8TiV\"],\"url\":\"https://kr8tiv.io\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://kr8tiv.io/kr8tiv-assets/kr8tiv-logo-filled.png\",\"width\":660,\"height\":220},\"image\":\"https://kr8tiv.io/kr8tiv-assets/kr8tiv-logo-filled.png\",\"description\":\"KR8TIV is a cyber-renaissance design atelier. We build brands, websites, motion, and full AI systems for founders who want to be memorable — not generic.\",\"slogan\":\"Built for founders who'd rather start a cult than a brand.\",\"foundingDate\":\"2020\",\"founder\":{\"@type\":\"Person\",\"@id\":\"https://kr8tiv.io/#matt\",\"name\":\"Matt Haynes\",\"jobTitle\":\"Founder & Creative Director\",\"url\":\"https://kr8tiv.io/#why\"},\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\",\"addressCountry\":\"CA\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Edmonton, Alberta\"},{\"@type\":\"Place\",\"name\":\"Leduc, Alberta\"},{\"@type\":\"Place\",\"name\":\"Alberta, Canada\"},{\"@type\":\"Place\",\"name\":\"Worldwide\"}],\"knowsAbout\":[\"Brand Design\",\"Web Design\",\"Motion Design\",\"Video Editing\",\"AI Automation\",\"AI Marketing\",\"AI Business Solutions\",\"Creative Direction\",\"User Experience\",\"Art Direction\",\"Ecommerce Design\",\"Packaging Design\",\"3D Design\",\"Product Design\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"telephone\":\"+1-780-915-5471\",\"email\":\"matt@kr8tiv.io\",\"url\":\"https://calendly.com/kr8tiv\",\"availableLanguage\":[\"en\"]}],\"sameAs\":[\"https://calendly.com/kr8tiv\",\"https://github.com/kr8tiv-io\",\"https://www.linkedin.com/company/kr8tiv-agency\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"@id\":\"https://kr8tiv.io/#matt\",\"name\":\"Matt Haynes\",\"url\":\"https://kr8tiv.io/#why\",\"jobTitle\":\"Founder & Creative Director\",\"worksFor\":{\"@id\":\"https://kr8tiv.io/#organization\"},\"sameAs\":[\"https://calendly.com/kr8tiv\",\"https://www.linkedin.com/in/matthaynes88/\",\"https://github.com/Matt-Aurora-Ventures\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://kr8tiv.io/#website\",\"url\":\"https://kr8tiv.io\",\"name\":\"KR8TIV\",\"description\":\"KR8TIV — cyber-renaissance design atelier. Brands, websites, motion, AI.\",\"publisher\":{\"@id\":\"https://kr8tiv.io/#organization\"},\"inLanguage\":\"en-US\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"@id\":\"https://kr8tiv.io/#service\",\"name\":\"KR8TIV Design Atelier\",\"description\":\"Boutique creative studio building brands, websites, motion, video, and full AI solutions for forward-looking founders.\",\"url\":\"https://kr8tiv.io\",\"image\":\"https://kr8tiv.io/kr8tiv-assets/og-card-v2.png\",\"logo\":\"https://kr8tiv.io/kr8tiv-assets/kr8tiv-logo-filled.png\",\"priceRange\":\"$$$\",\"telephone\":\"+1-780-915-5471\",\"email\":\"matt@kr8tiv.io\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Edmonton\",\"addressRegion\":\"AB\",\"addressCountry\":\"CA\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":53.5461,\"longitude\":-113.4938},\"areaServed\":[\"Edmonton\",\"Leduc\",\"Alberta\",\"Canada\",\"Worldwide\"],\"serviceType\":[\"Brand Identity Design\",\"Website Design & Development\",\"Motion & 3D Design\",\"Video Production\",\"AI Marketing Automation\",\"AI Business Solutions\",\"AI Agents & Internal Tools\"],\"provider\":{\"@id\":\"https://kr8tiv.io/#organization\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"KR8TIV services\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Brand Identity\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Website Design & Build\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Motion & 3D\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"AI Marketing Automation\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"AI Business Solutions\"}}]}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://kr8tiv.io/#webpage\",\"url\":\"https://kr8tiv.io/\",\"name\":\"Web Design & Branding in Edmonton | KR8TIV\",\"description\":\"Edmonton creative studio for branding, websites, immersive visuals, sign design, packaging, and marketing systems that help businesses find customers.\",\"isPartOf\":{\"@id\":\"https://kr8tiv.io/#website\"},\"about\":{\"@id\":\"https://kr8tiv.io/#organization\"},\"inLanguage\":\"en-US\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://kr8tiv.io/kr8tiv-assets/og-card-v2.png\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://kr8tiv.io/\"}]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is KR8TIV?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"KR8TIV is a boutique cyber-renaissance design atelier based in Alberta, Canada, and working globally. We build brands, websites, motion, video, and full AI business solutions for founders who want to be memorable — not generic. We work with about ten clients a year; every project gets the founder in the room.\"}},{\"@type\":\"Question\",\"name\":\"What services does KR8TIV offer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Brand identity, website design and development, motion + 3D, video editing, ads + acquisition creative, packaging, print + editorial, ecommerce, and full AI solutions — including AI marketing automation, customer-facing agents, internal tools, and content engines — for any business looking to save time and money.\"}},{\"@type\":\"Question\",\"name\":\"Does KR8TIV build AI solutions for businesses?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Beyond brand and web, KR8TIV builds end-to-end AI systems for business: marketing automations, customer support agents, internal research tools, content engines, and creative pipelines. We design AI infrastructure that saves small teams real hours every week — for marketing and beyond.\"}},{\"@type\":\"Question\",\"name\":\"How do I start a project with KR8TIV?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The easiest way is to book a 30-minute, no-obligation call at calendly.com/kr8tiv. If we're a fit, we move forward; if we're not, we'll point you somewhere that is. You can also fill out the full intake questionnaire at /start/ or email matt@kr8tiv.io directly.\"}},{\"@type\":\"Question\",\"name\":\"What does a KR8TIV project cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Full websites start from $1,200 CAD and focused landing pages from $600 CAD. Storefront sign concepts start from about $500 CAD, and identity systems from roughly $500. Those are floors — most projects land between $2k and $25k. For storefronts, full stores, 3D immersive store experiences and packaging, KR8TIV can also project-manage supplier sourcing, manufacturing coordination and installation liaison at variable rates; fabricators and builders do the physical work and production costs are quoted separately. Our standard payment split is 40% at kickoff, 40% at draft delivery, 20% at final. We accept Bitcoin, Ethereum, other cryptocurrencies, and traditional fiat payments.\"}},{\"@type\":\"Question\",\"name\":\"Where is KR8TIV based?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"KR8TIV is headquartered in Alberta, Canada — in the Edmonton–Leduc area — and works with clients worldwide, fully remote. Founded in 2020 by Matt Haynes.\"}}]}</script><!-- Sitemap + RSS autodiscovery (sitemap emitted by @astrojs/sitemap) --><link rel=\"sitemap\" type=\"application/xml\" href=\"/sitemap-index.xml\"><link rel=\"alternate\" type=\"application/rss+xml\" title=\"KR8TIV Build Notes\" href=\"/rss.xml\"><link rel=\"icon\" href=\"/kr8tiv-assets/cropped-Design-24-32x32.png\"><link rel=\"apple-touch-icon\" href=\"/kr8tiv-assets/cropped-Design-24-32x32.png\"><link rel=\"manifest\" href=\"/manifest.webmanifest\"><!-- Speculation Rules: prerender neighboring variant pages so the\n       variant-bar feels instant on Chrome/Edge. --><script type=\"speculationrules\">{\"prerender\":[{\"source\":\"document\",\"where\":{\"href_matches\":\"/kr8tiv-v*\"},\"eagerness\":\"moderate\"}]}</script><!-- Fonts — self-hosted woff2 (see src/styles/fonts.css). Variable\n       axes are preserved (JetBrains Mono 100–800, Inter Tight 100–900)\n       so font-variation-settings can still be tweened at runtime by\n10→       scroll velocity / hover state.\n\n       Previously these came from fonts.googleapis.com behind a\n       media=\"print\" swap: that dodged render-blocking but cost a DNS\n       + TLS + CSS round trip to a third origin before the browser\n       even learned which woff2 to request — on a throttled phone that\n       is most of a second of fallback-font text. Same bytes, own\n       origin, discovered on the first connection.\n\n       The two faces the first screen actually paints (hero serif +\n20→       mono chrome, latin subset) are preloaded; the rest arrive with\n       the stylesheet. `crossorigin` is required on font preloads even\n       same-origin — without it the preload is fetched in a different\n       CORS mode than the CSS request and downloads twice. --><link rel=\"preload\" as=\"