html.match(/<video\\b/gi) || []).length;\n  const scriptCount = (html.match(/<script\\b/gi) || []).length;\n  const h1InSource = /<h1\\b/i.test(html);\n  const answerOnlyInScript = false;\n  return {\n    file: file.replace(root, 'dist'),\n    route,\n    title,\n    titleLen: title.length,\n    description,\n    descLen: description.length,\n    canonical,\n    robots: robots || '(absent — default index,follow)',\n    h1s: vis.h1s,\n    first100: vis.words.slice(0, 100).join(' '),\n    wordCount: vis.words.length,\n    out,\n    videoCount,\n    scriptCount,\n    h1InSource,\n  };\n});\n\nconst byRoute = new Map(pages.map((p) => [p.route, p]));\nfor (const p of pages) {\n  p.in = [];\n}\nfor (const p of pages) {\n  for (const dest of p.out) {\n    const t = byRoute.get(dest);\n    if (t) t.in.push(p.route);\n    else p.unresolved = p.unresolved || [], p.unresolved.push(dest);\n  }\n}\n\nconst queries = {\n  '/': ['web design', 'edmonton'],\n  '/services/web-design-edmonton/': ['web design', 'edmonton'],\n  '/services/branding/': ['branding', 'edmonton'],\n  '/services/print-signage-design/': ['sign', 'edmonton'],\n  '/process/': ['process'],\n  '/work/': ['work'],\n  '/start/': ['start'],\n  '/blog/': ['field notes'],\n  '/blog/website-that-earns-its-keep-alberta/': ['website'],\n  '/blog/storefront-sign-design-edmonton/': ['storefront', 'sign'],\n  '/blog/blog-that-ranks-and-brings-leads/': ['blog'],\n  '/blog/local-advertising-edmonton-alberta/': ['advertising', 'edmonton'],\n  '/blog/marketing-campaign-edmonton/': ['marketing', 'campaign', 'edmonton'],\n  '/terms/': ['privacy', 'terms'],\n  '/menu-lab/': ['menu'],\n  '/build-notes/': ['build'],\n  '/404': ['not found'],\n};\n\nfunction hasToken(hay, token) {\n  return hay.toLowerCase().includes(token.toLowerCase());\n}\n\nfor (const p of pages) {\n  const q = queries[p.route] || [];\n  const hayTitle = p.title;\n  const hayH1 = p.h1s.join(' ');\n  const hay100 = p.first100;\n  const missing = [];\n  for (const token of q) {\n    const inTitle = hasToken(hayTitle, token);\n    const inH1 = hasToken(hayH1, token);\n    const in100 = hasToken(hay100, token);\n    if (!inTitle || !inH1 || !in100) {\n      missing.push({ token, inTitle, inH1, in100 });\n    }\n  }\n  p.missing = missing;\n  p.flags = [];\n  if (!p.title) p.flags.push('MISSING title');\n  if (!p.description) p.flags.push('MISSING meta description');\n  if (!p.canonical) p.flags.push('MISSING canonical');\n  if (!p.h1s.length) p.flags.push('MISSING H1 in raw HTML');\n  if (p.h1s.length > 1) p.flags.push(`MULTIPLE H1 (${p.h1s.length})`);\n  if (p.wordCount < 40) p.flags.push('THIN visible text (<40 words)');\n  if (p.videoCount && p.wordCount < 80) p.flags.push('Answer may lean on video (low word count + video)');\n  for (const m of missing) {\n    const where = [\n      !m.inTitle ? 'title' : null,\n      !m.inH1 ? 'H1' : null,\n      !m.in100 ? 'first 100' : null,\n    ].filter(Boolean).join(', ');\n    p.flags.push(`query \"${m.token}\" missing from ${where}`);\n  }\n}\n\nconsole.log(JSON.stringify({ count: pages.length, pages }, null, 2));\n","_meta":{"details":[{"old_string":"","old_line":1,"new_string":"import { readFileSync, readdirSync, statSync } from 'node:fs';\nimport { join } from 'node:path';\n\nconst root = '/workspace/kio-seo-imagine/dist';\n\nfunction walk(dir, acc = []) {\n  for (const name of readdirSync(dir)) {\n    const p = join(dir, name);\n    if (statSync(p).isDirectory()) walk(p, acc);\n    else if (name === 'index.html' || name === '404.html') acc.push(p);\n  }\n  return acc;\n}\n\nfunction decode(s) {\n  return s\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;|&apos;/g, \"'\")\n    .replace(/&#(\\d+);/g, (_, n) => String.fromCharCode(Number(n)))\n    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCharCode(parseInt(n, 16)));\n}\n\nfunction attr(html, tagRe) {\n  const